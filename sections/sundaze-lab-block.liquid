{% comment %}
  Sundaze — Lab / COA block
  Blueprint 4. Routes shoppers to the central Lab Results page from the homepage.
{% endcomment %}

<section class="sz-lab" id="sz-lab-{{ section.id }}">
  <div class="sz-lab__inner">
    <div class="sz-lab__card">
      <div class="sz-lab__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="sz-lab__eyebrow">
            <span class="sz-lab__eyebrow-dot" aria-hidden="true"></span>
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        <h2 class="sz-lab__title">
          {{- section.settings.heading -}}
          {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif -%}
        </h2>

        {%- if section.settings.body != blank -%}
          <div class="sz-lab__body">{{ section.settings.body }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="sz-lab__cta" href="{{ section.settings.button_link | default: '/pages/coa' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/><line x1="9" y1="11" x2="13" y2="11"/></svg>
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="sz-lab__points">
          {%- for block in section.blocks -%}
            <li class="sz-lab__point" {{ block.shopify_attributes }}>
              <span class="sz-lab__point-num" aria-hidden="true">{{ forloop.index }}</span>
              <span class="sz-lab__point-copy">
                <strong>{{ block.settings.title }}</strong>
                {%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;700&display=swap');

  #sz-lab-{{ section.id }} {
    --sun-rose:  #c4607a;
    --sun-mauve: #a84f6a;
    --sun-blush: #e8a0b4;
    --sun-peach: #d4926e;
    --sun-ink:   #1e1118;
    --sun-text:  rgba(30,17,24,0.82);
    --sun-muted: rgba(30,17,24,0.48);
    --sun-line:  rgba(196,96,122,0.18);

    display: block;
    background: {{ section.settings.bg_color }};
    font-family: 'DM Sans', sans-serif;
    color: var(--sun-ink);
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }

  #sz-lab-{{ section.id }} * { box-sizing: border-box; }

  #sz-lab-{{ section.id }} .sz-lab__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  #sz-lab-{{ section.id }} .sz-lab__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(28px, 4vw, 44px);
    padding: clamp(32px, 4.5vw, 60px);
    border-radius: 28px;
    border: 1px solid var(--sun-line);
    background:
      radial-gradient(ellipse 70% 90% at 100% 0%, rgba(232,160,180,0.28) 0%, transparent 62%),
      linear-gradient(135deg, #ffffff 0%, #fff8e8 100%);
    box-shadow: 0 18px 50px rgba(30,17,24,0.06);
  }

  #sz-lab-{{ section.id }} .sz-lab__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sun-mauve);
    margin: 0 0 16px;
  }

  #sz-lab-{{ section.id }} .sz-lab__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--sun-blush), var(--sun-rose));
  }

  #sz-lab-{{ section.id }} .sz-lab__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4.6vw, 56px);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 18px;
    color: #111111;
  }

  /* Accent words — same gradient italic as "Collections" in Lineup Cards. */
  #sz-lab-{{ section.id }} .sz-lab__title em {
    font-style: italic;
    background: linear-gradient(135deg, #e8728a 0%, #c94b7b 40%, #b8426e 70%, #a83d65 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  #sz-lab-{{ section.id }} .sz-lab__copy {
    max-width: 700px;
  }

  #sz-lab-{{ section.id }} .sz-lab__body p {
    font-size: clamp(15px, 1.5vw, 17px);
    font-weight: 300;
    line-height: 1.8;
    color: var(--sun-text);
    margin: 0 auto 16px;
    max-width: 60ch;
  }

  #sz-lab-{{ section.id }} .sz-lab__body a {
    color: var(--sun-mauve);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #sz-lab-{{ section.id }} a.sz-lab__cta,
  #sz-lab-{{ section.id }} a.sz-lab__cta:link,
  #sz-lab-{{ section.id }} a.sz-lab__cta:visited {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding: 15px 30px;
    border-radius: 50px;
    background: linear-gradient(135deg, var(--sun-peach) 0%, var(--sun-rose) 55%, var(--sun-mauve) 100%);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
    box-shadow: 0 8px 24px rgba(196,96,122,0.28);
    transition:
      transform 0.34s cubic-bezier(0.22, 0.68, 0.28, 1),
      box-shadow 0.34s cubic-bezier(0.22, 0.68, 0.28, 1);
    transform: translateY(0);
    will-change: transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  #sz-lab-{{ section.id }} a.sz-lab__cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(196,96,122,0.4);
  }

  #sz-lab-{{ section.id }} .sz-lab__cta svg {
    width: 17px;
    height: 17px;
  }

  /* ── Points ── */
  #sz-lab-{{ section.id }} .sz-lab__points {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
  }

  #sz-lab-{{ section.id }} .sz-lab__point {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    padding: 22px 18px;
    border-radius: 16px;
    background: rgba(255,255,255,0.72);
    border: 1px solid var(--sun-line);
  }

  #sz-lab-{{ section.id }} .sz-lab__point-num {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--sun-peach), var(--sun-rose));
    color: #fff;
    font-size: 12px;
    font-weight: 700;
  }

  #sz-lab-{{ section.id }} .sz-lab__point-copy {
    display: block;
    font-size: 14.5px;
    line-height: 1.6;
  }

  #sz-lab-{{ section.id }} .sz-lab__point-copy strong {
    display: block;
    font-weight: 700;
    color: var(--sun-ink);
    margin-bottom: 3px;
  }

  #sz-lab-{{ section.id }} .sz-lab__point-copy span {
    color: var(--sun-muted);
    font-weight: 300;
  }

  @media (prefers-reduced-motion: reduce) {
    #sz-lab-{{ section.id }} a.sz-lab__cta { transition: none; }
    #sz-lab-{{ section.id }} a.sz-lab__cta:hover { transform: none; }
  }
</style>

{% schema %}
{
  "name": "Sundaze Lab Block",
  "tag": "section",
  "class": "sundaze-lab-block-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Third-Party Lab Tested"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H2)",
      "default": "Know What's"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "info": "Rendered italic in the brand gradient, after the heading.",
      "default": "Inside."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy",
      "default": "<p>Every eligible Sundaze product should connect customers to its available third-party lab report. Make COAs easy to find from product pages and from one central Lab Results page.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View Lab Results"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Point this at the Lab Results / COA page."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FDE8F0"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Match the product"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Supporting text",
          "default": "Check the name, batch or lot number and dates."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Sundaze Lab Block",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "title": "Match the product",
            "text": "Check the name, batch or lot number and dates."
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Read the cannabinoid panel",
            "text": "THCA, delta-9 THC, CBD and the units used."
          }
        },
        {
          "type": "point",
          "settings": {
            "title": "Check the laboratory",
            "text": "The report should clearly identify who tested it."
          }
        }
      ]
    }
  ]
}
{% endschema %}
