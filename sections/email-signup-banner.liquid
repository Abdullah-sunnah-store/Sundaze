{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}
{{ 'section-email-signup-banner.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }

  {%- if section.settings.image_height == 'adapt-image' and section.settings.image != blank -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    #Banner-{{ section.id }}::before,
    #Banner-{{ section.id }} .banner__media::before {
      padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
      content: '';
      display: block;
    }
  {%- endif -%}
  .newsletter-form__field-wrapper.newsletter-form__field-wrapper--stacked .field:after { box-shadow: none; }
  #NewsletterSuccess--{{ section.id }} .newsletter-form__message--success {
    font-size: 2.2rem;
    line-height: 1.2;
  }
  .password-main .newsletter-form--stacked .field__input {
    margin-bottom: 5px;
}

  {%- if section.settings.show_falling_tubes -%}
  /* Falling product tubes — identical treatment to the Sundaze age gate,
     sitting behind all page content over the cream gradient. */
  .password-tubes {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  /* Lift the real page content above the tubes so it stays readable while the
     tubes show through the transparent gaps (same look as the age gate). */
  .password-header,
  .password__footer,
  .password-main .email-signup-banner__box {
    position: relative;
    z-index: 1;
  }
  .password-tubes .falling-tube {
    position: absolute;
    top: -480px;
    left: var(--col, 6%);
    width: 220px;
    height: 360px;
    object-fit: contain;
    object-position: center;
    filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.08));
    animation: tubeFall var(--fd, 11s) linear var(--fdd, 0s) infinite,
               tubeWobble var(--wd, 3s) ease-in-out var(--wdd, 0s) infinite;
    transform-origin: center center;
    will-change: top, transform, opacity;
  }
  @keyframes tubeFall {
    0% { top: -480px; opacity: 0; } 5% { opacity: 1; } 92% { opacity: 1; } 100% { top: 110vh; opacity: 0; }
  }
  @keyframes tubeWobble {
    0% { transform: rotate(-9deg); } 25% { transform: rotate(9deg); } 50% { transform: rotate(-9deg); } 75% { transform: rotate(9deg); } 100% { transform: rotate(-9deg); }
  }
  @media (max-width: 768px) {
    .password-tubes .falling-tube { width: 120px; height: 300px; }
  }
  {%- endif -%}
{%- endstyle -%}

{%- if section.settings.show_falling_tubes -%}
  <div class="password-tubes" aria-hidden="true">
    {% if section.settings.tube_1 != blank %}<img class="falling-tube" src="{{ section.settings.tube_1 | img_url: '400x' }}" style="--col:6%;--fd:11s;--fdd:0s;--wd:3s;--wdd:0s" alt="">{% endif %}
    {% if section.settings.tube_3 != blank %}<img class="falling-tube" src="{{ section.settings.tube_3 | img_url: '400x' }}" style="--col:8%;--fd:11s;--fdd:3.7s;--wd:3.2s;--wdd:0.5s" alt="">{% endif %}
    {% if section.settings.tube_2 != blank %}<img class="falling-tube" src="{{ section.settings.tube_2 | img_url: '400x' }}" style="--col:5%;--fd:11s;--fdd:7.3s;--wd:2.8s;--wdd:1s" alt="">{% endif %}
    {% if section.settings.tube_2 != blank %}<img class="falling-tube" src="{{ section.settings.tube_2 | img_url: '400x' }}" style="--col:30%;--fd:11.8s;--fdd:0.8s;--wd:2.8s;--wdd:0.2s" alt="">{% endif %}
    {% if section.settings.tube_4 != blank %}<img class="falling-tube" src="{{ section.settings.tube_4 | img_url: '400x' }}" style="--col:28%;--fd:11.8s;--fdd:4.7s;--wd:3.1s;--wdd:0.7s" alt="">{% endif %}
    {% if section.settings.tube_1 != blank %}<img class="falling-tube" src="{{ section.settings.tube_1 | img_url: '400x' }}" style="--col:31%;--fd:11.8s;--fdd:8.6s;--wd:3s;--wdd:1.2s" alt="">{% endif %}
    {% if section.settings.tube_3 != blank %}<img class="falling-tube" src="{{ section.settings.tube_3 | img_url: '400x' }}" style="--col:57%;--fd:12.2s;--fdd:1.7s;--wd:3s;--wdd:0.4s" alt="">{% endif %}
    {% if section.settings.tube_1 != blank %}<img class="falling-tube" src="{{ section.settings.tube_1 | img_url: '400x' }}" style="--col:59%;--fd:12.2s;--fdd:5.8s;--wd:2.7s;--wdd:0.9s" alt="">{% endif %}
    {% if section.settings.tube_4 != blank %}<img class="falling-tube" src="{{ section.settings.tube_4 | img_url: '400x' }}" style="--col:56%;--fd:12.2s;--fdd:9.8s;--wd:3.2s;--wdd:0.3s" alt="">{% endif %}
    {% if section.settings.tube_4 != blank %}<img class="falling-tube" src="{{ section.settings.tube_4 | img_url: '400x' }}" style="--col:82%;--fd:11.5s;--fdd:2.3s;--wd:2.7s;--wdd:0.6s" alt="">{% endif %}
    {% if section.settings.tube_2 != blank %}<img class="falling-tube" src="{{ section.settings.tube_2 | img_url: '400x' }}" style="--col:80%;--fd:11.5s;--fdd:6.1s;--wd:3.1s;--wdd:0.1s" alt="">{% endif %}
    {% if section.settings.tube_3 != blank %}<img class="falling-tube" src="{{ section.settings.tube_3 | img_url: '400x' }}" style="--col:83%;--fd:11.5s;--fdd:10s;--wd:2.9s;--wdd:0.8s" alt="">{% endif %}
  </div>
{%- endif -%}

<div
  id="Banner-{{ section.id }}"
  class="email-signup-banner banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.image_height == 'adapt-image' and section.settings.image != blank %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}"
>
  {%- if section.settings.show_background_image -%}
    <div class="banner__media{% if section.settings.image != blank %} media{% endif %}">
      {%- if section.settings.image != blank -%}
        <img
          srcset="
            {%- if section.settings.image.width >= 375 -%}{{ section.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
            {%- if section.settings.image.width >= 750 -%}{{ section.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if section.settings.image.width >= 1100 -%}{{ section.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
            {%- if section.settings.image.width >= 1500 -%}{{ section.settings.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {%- if section.settings.image.width >= 1780 -%}{{ section.settings.image | image_url: width: 1780 }} 1780w,{%- endif -%}
            {%- if section.settings.image.width >= 2000 -%}{{ section.settings.image | image_url: width: 2000 }} 2000w,{%- endif -%}
            {%- if section.settings.image.width >= 3000 -%}{{ section.settings.image | image_url: width: 3000 }} 3000w,{%- endif -%}
            {%- if section.settings.image.width >= 3840 -%}{{ section.settings.image | image_url: width: 3840 }} 3840w,{%- endif -%}
            {{ section.settings.image | image_url }} {{ section.settings.image.width }}w
          "
          sizes="100vw"
          src="{{ section.settings.image | image_url: width: 1500 }}"
          loading="lazy"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.width | divided_by: section.settings.image.aspect_ratio }}"
        >
      {%- else -%}
        {{- 'email-signup-banner-background.svg' | inline_asset_content -}}
        {{- 'email-signup-banner-background-mobile.svg' | inline_asset_content -}}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width">
    <div class="email-signup-banner__box banner__box newsletter newsletter__wrapper isolate{% if section.settings.show_background_image == false %} email-signup-banner__box--no-image{% endif %} content-container color-{{ section.settings.color_scheme }} gradient content-container--full-width-mobile">
      {%- if section.settings.show_falling_tubes and settings.logo != blank -%}
        <img
          class="password-banner-logo"
          src="{{ settings.logo | image_url: width: 800 }}"
          alt="{{ shop.name | escape }}"
          width="440"
          height="{{ 440 | divided_by: settings.logo.aspect_ratio }}"
          loading="eager"
        >
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2 class="email-signup-banner__heading {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
              {{ block.settings.heading | escape }}
            </h2>
          {%- when 'paragraph' -%}
            <div class="newsletter__subheading rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- when 'email_form' -%}
            <div {{ block.shopify_attributes }}>
              {% form 'customer', class: 'newsletter-form newsletter-form--stacked' %}
                {%- if form.posted_successfully? -%}{%- assign newsletter_success = true -%}{%- endif -%}
                <input type="hidden" name="contact[tags]" value="newsletter, password-page">
                <div
                  class="newsletter-form__field-wrapper newsletter-form__field-wrapper--stacked"
                  {% if form.posted_successfully? %}hidden{% endif %}
                >
                  <div class="field">
                    <input
                      id="NewsletterEmail--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="field__input"
                      value="{{ form.email }}"
                      aria-required="false"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        aria-invalid="true"
                        aria-describedby="Newsletter-error--{{ section.id }}"
                      {% endif %}
                      placeholder="Email Address"
                    >
                    <label class="field__label" for="NewsletterEmail--{{ section.id }}">
                      Email Address
                    </label>
                  </div>
                  {%- if block.settings.show_phone -%}
                    {%- assign phone_label = block.settings.phone_label | default: 'Phone number' -%}
                    <div class="field">
                      <input
                        id="NewsletterPhone--{{ section.id }}"
                        type="tel"
                        name="contact[phone]"
                        class="field__input"
                        value="{{ form.phone }}"
                        autocomplete="tel"
                        pattern="[\d\s()+\-]*"
                        placeholder="{{ phone_label | escape }}"
                      >
                      <label class="field__label" for="NewsletterPhone--{{ section.id }}">
                        {{ phone_label }}
                      </label>
                    </div>
                  {%- endif -%}
                  <button
                    type="button"
                    class="newsletter-form__join button"
                    id="Subscribe"
                  >
                    {{ block.settings.button_label | default: 'JOIN THE LIST' }}
                    <span class="newsletter-form__spinner" aria-hidden="true"></span>
                  </button>
                  {%- if block.settings.show_contact_cta -%}
                    <button
                      type="button"
                      class="newsletter-form__contact-cta"
                      data-contact-open
                      aria-haspopup="dialog"
                      aria-controls="ContactPanel--{{ section.id }}"
                    >
                      {{ block.settings.contact_button_label | default: 'Contact Us' }}
                    </button>
                  {%- endif -%}
                  <small
                    class="newsletter-form__message form__message"
                    data-newsletter-client-error
                    hidden
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    Please enter an email address or phone number.
                  </small>
                  <small
                    class="newsletter-form__message form__message"
                    data-newsletter-ajax-error
                    role="status"
                    hidden
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <span data-newsletter-ajax-error-text></span>
                  </small>
                  {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </small>
                  {%- endif -%}
                  {%- if block.settings.opt_in_text != blank -%}
                    <div class="newsletter-form__optin rte">
                      {{ block.settings.opt_in_text }}
                    </div>
                  {%- endif -%}
                </div>
              {% endform %}

              {%- comment -%}
                Success state — rendered OUTSIDE the newsletter form (no nested forms).
                Hidden until signup succeeds (server-side via Liquid, or revealed by AJAX).
                Contains the one-click "Enter the Site" button that submits the
                storefront password for the visitor.
              {%- endcomment -%}
              <div
                id="NewsletterSuccess--{{ section.id }}"
                class="newsletter-form__success-wrap"
                tabindex="-1"
                {% unless newsletter_success %}hidden{% endunless %}
              >
                <h3 class="newsletter-form__message newsletter-form__message--success form__message">
                  <span class="svg-wrapper">
                    {{- 'icon-success.svg' | inline_asset_content -}}
                  </span>
                  {{ block.settings.success_text | default: "You're on the list!" }}
                </h3>
                <div class="newsletter-form__enter">
                  {%- if block.settings.show_contact_cta -%}
                    <button
                      type="button"
                      class="newsletter-form__contact-cta newsletter-form__contact-cta--success"
                      data-contact-open
                      aria-haspopup="dialog"
                      aria-controls="ContactPanel--{{ section.id }}"
                    >
                      {{ block.settings.contact_button_label | default: 'Contact Us' }}
                    </button>
                  {%- endif -%}
                </div>
              </div>

              <script>
                (function () {
                  var emailInput = document.getElementById('NewsletterEmail--{{ section.id }}');
                  if (!emailInput) return;
                  var form = emailInput.closest('form');
                  if (!form) return;
                  var phoneInput = form.querySelector('input[name="contact[phone]"]');
                  var clientError = form.querySelector('[data-newsletter-client-error]');
                  var ajaxError = form.querySelector('[data-newsletter-ajax-error]');
                  var ajaxErrorText = form.querySelector('[data-newsletter-ajax-error-text]');
                  var submitBtn = form.querySelector('.newsletter-form__join');
                  var successWrap = document.getElementById('NewsletterSuccess--{{ section.id }}');
                  var resendTimerEl = successWrap ? successWrap.querySelector('[data-resend-timer]') : null;
                  var resendBtn = successWrap ? successWrap.querySelector('[data-resend-btn]') : null;
                  var resendInterval = null;
                  var RESEND_SECONDS = 180; // 3 minutes

                  function setLoading(on) {
                    if (!submitBtn) return;
                    submitBtn.classList.toggle('is-loading', on);
                    submitBtn.disabled = on;
                  }
                  function showAjaxError(msg) {
                    if (ajaxErrorText) ajaxErrorText.textContent = msg;
                    if (ajaxError) ajaxError.hidden = false;
                  }
                  function fmtTime(sec) {
                    var m = Math.floor(sec / 60);
                    var s = sec % 60;
                    return m + ':' + (s < 10 ? '0' + s : s);
                  }
                  function startResendCountdown() {
                    if (!resendTimerEl || !resendBtn) return;
                    var remaining = RESEND_SECONDS;
                    resendBtn.hidden = true;
                    resendBtn.disabled = false;
                    resendBtn.textContent = "Didn't get it? Resend email";
                    resendTimerEl.hidden = false;
                    resendTimerEl.textContent = 'Resend available in ' + fmtTime(remaining);
                    if (resendInterval) clearInterval(resendInterval);
                    resendInterval = setInterval(function () {
                      remaining -= 1;
                      if (remaining <= 0) {
                        clearInterval(resendInterval);
                        resendInterval = null;
                        resendTimerEl.hidden = true;
                        resendBtn.hidden = false;
                      } else {
                        resendTimerEl.textContent = 'Resend available in ' + fmtTime(remaining);
                      }
                    }, 1000);
                  }
                  function reveal() {
                    form.style.display = 'none';
                    if (successWrap) {
                      successWrap.hidden = false;
                      try { successWrap.focus(); } catch (e) {}
                    }
                    startResendCountdown();
                  }

                  var EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

                  function handleSubscribe(event) {
                    if (event) event.preventDefault();

                    var emailVal = emailInput.value.trim();
                    var phoneVal = phoneInput ? phoneInput.value.trim() : '';

                    // Need at least one of email / phone.
                    if (!emailVal && !phoneVal) {
                      if (ajaxError) ajaxError.hidden = true;
                      if (clientError) clientError.hidden = false;
                      emailInput.focus();
                      return;
                    }
                    if (clientError) clientError.hidden = true;

                    // If an email was typed, it must look valid.
                    if (emailVal && !EMAIL_RE.test(emailVal)) {
                      showAjaxError('Please enter a valid email address.');
                      emailInput.focus();
                      return;
                    }
                    if (ajaxError) ajaxError.hidden = true;

                    // No fetch support -> just take the visitor into the success state.
                    if (!window.fetch || !window.FormData) {
                      reveal();
                      return;
                    }

                    setLoading(true);

                    // Best-effort subscribe in the background, then show the success
                    // state no matter what Shopify returns. The page never navigates,
                    // so the bot-challenge screen can never appear.
                    fetch(form.action, {
                      method: 'POST',
                      body: new FormData(form),
                      headers: { 'Accept': 'text/html' }
                    })
                      .then(function () {
                        setLoading(false);
                        reveal();
                      })
                      .catch(function () {
                        setLoading(false);
                        reveal();
                      });
                  }

                  // The button is type="button", so a click can NEVER natively submit
                  // the form (no navigation to Shopify's challenge page). We also catch
                  // the Enter-key submit as a backstop.
                  if (submitBtn) submitBtn.addEventListener('click', handleSubscribe);
                  form.addEventListener('submit', handleSubscribe);

                  // Resend: re-submit the signup in the background, then restart the
                  // countdown. (Whether a new email actually sends depends on the
                  // email/SMS platform's resend rules.)
                  if (resendBtn) {
                    resendBtn.addEventListener('click', function () {
                      if (!window.fetch || !window.FormData) {
                        startResendCountdown();
                        return;
                      }
                      resendBtn.disabled = true;
                      resendBtn.textContent = 'Resending…';
                      fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: { 'Accept': 'text/html' }
                      })
                        .then(function () { startResendCountdown(); })
                        .catch(function () { startResendCountdown(); });
                    });
                  }

                  // If the success state is already shown on page load (server-side
                  // submit), kick off the countdown too.
                  if (successWrap && !successWrap.hidden) startResendCountdown();
                })();
              </script>

              {%- if block.settings.show_contact_cta -%}
                {%- comment -%}
                  Contact Us panel — a full-screen overlay that sits on the SAME
                  cream gradient / falling-tubes background as the signup screen
                  (transparent so the background never changes). Opened by the
                  "Contact Us" CTA, closed by the back button or Escape. The form
                  is AJAX-submitted (type="button") so the password page never
                  navigates to Shopify's bot-challenge screen.
                {%- endcomment -%}
                <div
                  id="ContactPanel--{{ section.id }}"
                  class="contact-panel"
                  role="dialog"
                  aria-modal="true"
                  aria-label="{{ block.settings.contact_heading | default: 'Contact us' | strip_html | escape }}"
                  hidden
                >
                  <div class="contact-panel__inner">
                    <button type="button" class="contact-panel__back" data-contact-close>
                      <span aria-hidden="true">&#8592;</span> Back
                    </button>

                    <div class="contact-panel__grid">
                      <div class="contact-panel__info">
                        <p class="contact-panel__eyebrow">{{ block.settings.contact_info_eyebrow | default: 'Contact Information' }}</p>
                        <h2 class="contact-panel__title">{{ block.settings.contact_heading | default: "We're here <em>to help you.</em>" }}</h2>
                        <div class="contact-panel__text rte">
                          {{ block.settings.contact_text | default: "<p>Whether you have a question about a product, an order, or just want to say hey — we'd love to hear from you. Real people. Real replies.</p>" }}
                        </div>
                        {%- if block.settings.contact_follow_text != blank -%}
                          <p class="contact-panel__eyebrow contact-panel__eyebrow--follow">{{ block.settings.contact_follow_text }}</p>
                        {%- endif -%}
                      </div>

                      <div class="contact-panel__form-col">
                        <p class="contact-panel__eyebrow">{{ block.settings.contact_form_eyebrow | default: 'Send a message' }}</p>
                        <h2 class="contact-panel__form-title">{{ block.settings.contact_form_heading | default: "Drop us a line and we'll be in touch." }}</h2>

                        {%- comment -%}
                          Plain <form> (not {% form 'contact' %}) — the password
                          layout only exposes the customer / storefront-password
                          form types, so {% form 'contact' %} errors there. This
                          posts the identical payload to /contact and is AJAX-
                          submitted by the script below, so the page never
                          navigates either way.
                        {%- endcomment -%}
                        <form
                          action="{{ routes.root_url }}contact#ContactForm--{{ section.id }}"
                          method="post"
                          id="ContactForm--{{ section.id }}"
                          class="contact-form"
                          accept-charset="UTF-8"
                        >
                          <input type="hidden" name="form_type" value="contact">
                          <input type="hidden" name="utf8" value="✓">
                          <input type="hidden" name="contact[tags]" value="contact, password-page">
                          <div class="contact-form__fields">
                            <div class="contact-form__row">
                              <div class="contact-form__field">
                                <label class="contact-form__label" for="ContactFirst--{{ section.id }}">First Name</label>
                                <input
                                  id="ContactFirst--{{ section.id }}"
                                  type="text"
                                  name="contact[First Name]"
                                  class="contact-form__input"
                                  autocomplete="given-name"
                                  placeholder="Jordan"
                                >
                              </div>
                              <div class="contact-form__field">
                                <label class="contact-form__label" for="ContactLast--{{ section.id }}">Last Name</label>
                                <input
                                  id="ContactLast--{{ section.id }}"
                                  type="text"
                                  name="contact[Last Name]"
                                  class="contact-form__input"
                                  autocomplete="family-name"
                                  placeholder="Rivera"
                                >
                              </div>
                            </div>

                            <div class="contact-form__field">
                              <label class="contact-form__label" for="ContactEmail--{{ section.id }}">Email Address</label>
                              <input
                                id="ContactEmail--{{ section.id }}"
                                type="email"
                                name="contact[email]"
                                class="contact-form__input"
                                value=""
                                autocorrect="off"
                                autocapitalize="off"
                                autocomplete="email"
                                placeholder="you@example.com"
                              >
                            </div>

                            <div class="contact-form__field">
                              <label class="contact-form__label" for="ContactSubject--{{ section.id }}">Subject</label>
                              <div class="contact-form__select-wrap">
                                <select
                                  id="ContactSubject--{{ section.id }}"
                                  name="contact[Subject]"
                                  class="contact-form__input contact-form__select"
                                >
                                  <option value="" selected>Select a topic…</option>
                                  <option value="Product question">Product question</option>
                                  <option value="Order status">Order status</option>
                                  <option value="Private access / wholesale">Private access / wholesale</option>
                                  <option value="Something else">Something else</option>
                                </select>
                                <span class="contact-form__select-caret" aria-hidden="true">&#9662;</span>
                              </div>
                            </div>

                            <div class="contact-form__field">
                              <label class="contact-form__label" for="ContactBody--{{ section.id }}">Your Message</label>
                              <textarea
                                id="ContactBody--{{ section.id }}"
                                name="contact[body]"
                                rows="4"
                                class="contact-form__input contact-form__textarea"
                                placeholder="Tell us how we can help…"
                              ></textarea>
                            </div>

                            <button type="button" class="contact-form__submit" data-contact-submit>
                              Send Message
                              <span class="contact-form__plane" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="18" height="18"><path d="M22 2 11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 2 15 22l-4-9-9-4 20-7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                              </span>
                              <span class="contact-form__spinner" aria-hidden="true"></span>
                            </button>

                            <small class="contact-form__error" data-contact-error role="status" hidden></small>
                          </div>
                        </form>

                        <div
                          class="contact-form__success"
                          data-contact-success
                          hidden
                        >
                          <span class="svg-wrapper">{{- 'icon-success.svg' | inline_asset_content -}}</span>
                          {{ block.settings.contact_success_text | default: "Thanks — your message is on its way. We'll be in touch soon." }}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <script>
                  (function () {
                    var panel = document.getElementById('ContactPanel--{{ section.id }}');
                    if (!panel) return;
                    var openBtns = document.querySelectorAll('[data-contact-open]');
                    var closeBtns = panel.querySelectorAll('[data-contact-close]');
                    var cForm = panel.querySelector('.contact-form');
                    var cSubmit = panel.querySelector('[data-contact-submit]');
                    var cError = panel.querySelector('[data-contact-error]');
                    var cFields = panel.querySelector('.contact-form__fields');
                    var cSuccess = panel.querySelector('[data-contact-success]');
                    var firstInput = document.getElementById('ContactFirst--{{ section.id }}');
                    var lastInput = document.getElementById('ContactLast--{{ section.id }}');
                    var emailInput = document.getElementById('ContactEmail--{{ section.id }}');
                    var EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

                    function openPanel() {
                      panel.hidden = false;
                      document.body.classList.add('contact-panel-open');
                      try { panel.querySelector('input, textarea, select, button').focus(); } catch (e) {}
                    }
                    function closePanel() {
                      panel.hidden = true;
                      document.body.classList.remove('contact-panel-open');
                    }
                    function showError(msg) {
                      if (!cError) return;
                      cError.textContent = msg;
                      cError.hidden = false;
                    }
                    function setLoading(on) {
                      if (!cSubmit) return;
                      cSubmit.classList.toggle('is-loading', on);
                      cSubmit.disabled = on;
                    }
                    function reveal() {
                      if (cFields) cFields.hidden = true;
                      if (cSuccess) cSuccess.hidden = false;
                    }

                    openBtns.forEach(function (b) { b.addEventListener('click', openPanel); });
                    closeBtns.forEach(function (b) { b.addEventListener('click', closePanel); });
                    document.addEventListener('keydown', function (e) {
                      if (e.key === 'Escape' && !panel.hidden) closePanel();
                    });

                    function handleSend(event) {
                      if (event) event.preventDefault();
                      if (!cForm) return;
                      if (cError) cError.hidden = true;

                      var emailVal = emailInput ? emailInput.value.trim() : '';
                      if (!emailVal || !EMAIL_RE.test(emailVal)) {
                        showError('Please enter a valid email address.');
                        if (emailInput) emailInput.focus();
                        return;
                      }

                      // Combine first + last into the standard contact[name] field so
                      // the notification email shows a proper sender name.
                      var fullName = ((firstInput ? firstInput.value.trim() : '') + ' ' +
                                      (lastInput ? lastInput.value.trim() : '')).trim();
                      var nameField = cForm.querySelector('input[name="contact[name]"]');
                      if (!nameField) {
                        nameField = document.createElement('input');
                        nameField.type = 'hidden';
                        nameField.name = 'contact[name]';
                        cForm.appendChild(nameField);
                      }
                      nameField.value = fullName;

                      if (!window.fetch || !window.FormData) { reveal(); return; }

                      setLoading(true);
                      fetch(cForm.action, {
                        method: 'POST',
                        body: new FormData(cForm),
                        headers: { 'Accept': 'text/html' }
                      })
                        .then(function () { setLoading(false); reveal(); })
                        .catch(function () { setLoading(false); reveal(); });
                    }

                    if (cSubmit) cSubmit.addEventListener('click', handleSend);
                    cForm.addEventListener('submit', handleSend);
                  })();
                </script>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%}
  Remove Shopify's bot-protection (hCaptcha) badge from the corner of the
  password page. It loads asynchronously, so we hide it on load and keep
  watching the DOM (MutationObserver) to catch it whenever it appears.
{%- endcomment -%}
<script>
  (function () {
    var SELECTORS = [
      '.grecaptcha-badge',
      '.h-captcha',
      '[class*="hcaptcha" i]',
      '[id*="hcaptcha" i]',
      '[class*="captcha" i]',
      'iframe[src*="hcaptcha.com"]',
      'iframe[src*="recaptcha"]',
      'iframe[title*="captcha" i]',
      'iframe[title*="hcaptcha" i]',
      'a[href*="hcaptcha.com"]'
    ];

    function kill(el) {
      // Climb to the outermost fixed/absolute wrapper (the floating badge box)
      // so the whole widget is hidden, not just the inner iframe/icon.
      var node = el;
      var p = el;
      for (var i = 0; i < 6 && p && p !== document.body; i++) {
        var pos = '';
        try { pos = window.getComputedStyle(p).position; } catch (e) {}
        if (pos === 'fixed' || pos === 'absolute') node = p;
        p = p.parentElement;
      }
      node.style.setProperty('display', 'none', 'important');
      node.style.setProperty('visibility', 'hidden', 'important');
      node.style.setProperty('opacity', '0', 'important');
      node.style.setProperty('pointer-events', 'none', 'important');
    }

    function sweep() {
      SELECTORS.forEach(function (s) {
        try {
          document.querySelectorAll(s).forEach(kill);
        } catch (e) {}
      });
    }

    sweep();
    document.addEventListener('DOMContentLoaded', sweep);
    window.addEventListener('load', sweep);
    try {
      var mo = new MutationObserver(sweep);
      mo.observe(document.documentElement, { childList: true, subtree: true });
      // Stop observing after the badge has had plenty of time to load.
      setTimeout(function () { mo.disconnect(); }, 20000);
    } catch (e) {}
  })();
</script>

