{% comment %}
  Sundaze — Knowledge Hub preview
  Blueprint 4. Three guide cards + a prominent internal link into the hub.
  Pick a blog to pull the newest articles automatically, or leave it empty and
  curate the cards by hand with blocks.
{% endcomment %}

{%- liquid
  assign auto_blog = blogs[section.settings.blog]
  assign use_auto = false
  if section.settings.blog != blank and auto_blog.articles_count > 0
    assign use_auto = true
  endif
  assign card_colors = 'sz-c1,sz-c2,sz-c3' | split: ','
-%}

<section class="sz-hub" id="sz-hub-{{ section.id }}">
  <div class="sz-hub__inner">
    <header class="sz-hub__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sz-hub__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="sz-hub__title">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_accent != blank %} <em>{{ section.settings.heading_accent }}</em>{% endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="sz-hub__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    <div class="sz-hub__grid">
      {%- if use_auto -%}
        {%- for article in auto_blog.articles limit: 3 -%}
          {%- assign tone = forloop.index0 | modulo: 3 -%}
          <a class="sz-hub__card sz-hub__card--tone{{ tone }}" href="{{ article.url }}">
            {%- if section.settings.show_images and article.image != blank -%}
              <span class="sz-hub__thumb">
                <img
                  src="{{ article.image | image_url: width: 700 }}"
                  alt="{{ article.image.alt | escape }}"
                  width="700"
                  height="440"
                  loading="lazy"
                >
              </span>
            {%- endif -%}
            <span class="sz-hub__card-body">
              {%- if article.tags.size > 0 -%}
                <span class="sz-hub__tag">{{ article.tags.first }}</span>
              {%- endif -%}
              <span class="sz-hub__card-title">{{ article.title }}</span>
              {%- if article.excerpt_or_content != blank -%}
                <span class="sz-hub__card-text">
                  {{- article.excerpt_or_content | strip_html | truncatewords: 22 -}}
                </span>
              {%- endif -%}
              <span class="sz-hub__read">
                {{ section.settings.card_link_label }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign tone = forloop.index0 | modulo: 3 -%}
          <a
            class="sz-hub__card sz-hub__card--tone{{ tone }}"
            href="{{ block.settings.link | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            {%- if section.settings.show_images and block.settings.image != blank -%}
              <span class="sz-hub__thumb">
                <img
                  src="{{ block.settings.image | image_url: width: 700 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              </span>
            {%- endif -%}
            <span class="sz-hub__card-body">
              {%- if block.settings.tag != blank -%}
                <span class="sz-hub__tag">{{ block.settings.tag }}</span>
              {%- endif -%}
              <span class="sz-hub__card-title">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}
                <span class="sz-hub__card-text">{{ block.settings.text }}</span>
              {%- endif -%}
              <span class="sz-hub__read">
                {{ section.settings.card_link_label }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="sz-hub__footer">
        <a class="sz-hub__cta" href="{{ section.settings.button_link | default: '/blogs/knowledge-hub' }}">
          {{ section.settings.button_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;700&display=swap');

  #sz-hub-{{ section.id }} {
    --sun-rose:  #c4607a;
    --sun-mauve: #a84f6a;
    --sun-blush: #e8a0b4;
    --sun-peach: #d4926e;
    --sun-ink:   #1e1118;
    --sun-text:  rgba(30,17,24,0.82);
    --sun-muted: rgba(30,17,24,0.48);
    --sun-line:  rgba(196,96,122,0.18);

    display: block;
    background: {{ section.settings.bg_color }};
    font-family: 'DM Sans', sans-serif;
    color: var(--sun-ink);
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    box-sizing: border-box;
  }

  #sz-hub-{{ section.id }} * { box-sizing: border-box; }

  #sz-hub-{{ section.id }} .sz-hub__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  #sz-hub-{{ section.id }} .sz-hub__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 44px;
  }

  #sz-hub-{{ section.id }} .sz-hub__eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sun-rose);
    margin: 0 0 14px;
  }

  #sz-hub-{{ section.id }} .sz-hub__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(32px, 4.6vw, 56px);
    font-weight: 900;
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
    color: #111111;
  }

  /* Accent words — same gradient italic as "Collections" in Lineup Cards. */
  #sz-hub-{{ section.id }} .sz-hub__title em {
    font-style: italic;
    background: linear-gradient(135deg, #e8728a 0%, #c94b7b 40%, #b8426e 70%, #a83d65 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  #sz-hub-{{ section.id }} .sz-hub__sub {
    font-size: clamp(15px, 1.5vw, 17px);
    font-weight: 300;
    line-height: 1.8;
    color: var(--sun-text);
    margin: 0;
  }

  /* ── Grid ── */
  #sz-hub-{{ section.id }} .sz-hub__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  #sz-hub-{{ section.id }} a.sz-hub__card,
  #sz-hub-{{ section.id }} a.sz-hub__card:link,
  #sz-hub-{{ section.id }} a.sz-hub__card:visited {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid var(--sun-line);
    background: #fff;
    color: var(--sun-ink);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    box-shadow: 0 10px 30px rgba(30,17,24,0.05);
  }

  #sz-hub-{{ section.id }} a.sz-hub__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 44px rgba(30,17,24,0.10);
  }

  #sz-hub-{{ section.id }} .sz-hub__card--tone0 { background: linear-gradient(160deg, #fff8e8 0%, #ffffff 58%); }
  #sz-hub-{{ section.id }} .sz-hub__card--tone1 { background: linear-gradient(160deg, #fde8f0 0%, #ffffff 58%); }
  #sz-hub-{{ section.id }} .sz-hub__card--tone2 { background: linear-gradient(160deg, #f2ecff 0%, #ffffff 58%); }

  #sz-hub-{{ section.id }} .sz-hub__thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgba(196,96,122,0.06);
  }

  #sz-hub-{{ section.id }} .sz-hub__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #sz-hub-{{ section.id }} .sz-hub__card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1 1 auto;
    padding: 28px 26px 26px;
  }

  #sz-hub-{{ section.id }} .sz-hub__tag {
    align-self: center;
    padding: 6px 14px;
    margin-bottom: 14px;
    border-radius: 50px;
    border: 1px solid rgba(196,96,122,0.28);
    background: rgba(255,255,255,0.7);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sun-mauve);
  }

  #sz-hub-{{ section.id }} .sz-hub__card-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(21px, 2.2vw, 26px);
    font-weight: 700;
    line-height: 1.22;
    margin-bottom: 12px;
  }

  #sz-hub-{{ section.id }} .sz-hub__card-text {
    font-size: 14.5px;
    font-weight: 300;
    line-height: 1.72;
    color: var(--sun-text);
    margin-bottom: 22px;
  }

  #sz-hub-{{ section.id }} .sz-hub__read {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: auto;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sun-mauve);
  }

  #sz-hub-{{ section.id }} .sz-hub__read svg {
    width: 15px;
    height: 15px;
    transition: transform 0.25s ease;
  }

  #sz-hub-{{ section.id }} a.sz-hub__card:hover .sz-hub__read svg {
    transform: translateX(4px);
  }

  /* ── Footer CTA ── */
  #sz-hub-{{ section.id }} .sz-hub__footer {
    text-align: center;
    margin-top: 44px;
  }

  #sz-hub-{{ section.id }} a.sz-hub__cta,
  #sz-hub-{{ section.id }} a.sz-hub__cta:link,
  #sz-hub-{{ section.id }} a.sz-hub__cta:visited {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 34px;
    border-radius: 50px;
    background: linear-gradient(135deg, var(--sun-peach) 0%, var(--sun-rose) 55%, var(--sun-mauve) 100%);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1;
    box-shadow: 0 8px 24px rgba(196,96,122,0.28);
    transition:
      transform 0.34s cubic-bezier(0.22, 0.68, 0.28, 1),
      box-shadow 0.34s cubic-bezier(0.22, 0.68, 0.28, 1);
    transform: translateY(0);
    will-change: transform;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  #sz-hub-{{ section.id }} a.sz-hub__cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 32px rgba(196,96,122,0.4);
  }

  #sz-hub-{{ section.id }} .sz-hub__cta svg {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 900px) {
    #sz-hub-{{ section.id }} .sz-hub__grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #sz-hub-{{ section.id }} a.sz-hub__card,
    #sz-hub-{{ section.id }} a.sz-hub__cta,
    #sz-hub-{{ section.id }} .sz-hub__read svg { transition: none; }
    #sz-hub-{{ section.id }} a.sz-hub__card:hover,
    #sz-hub-{{ section.id }} a.sz-hub__cta:hover { transform: none; }
  }
</style>

{% schema %}
{
  "name": "Sundaze Hub Preview",
  "tag": "section",
  "class": "sundaze-hub-preview-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Sundaze Knowledge Hub"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H2)",
      "default": "Learn Before"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent",
      "info": "Rendered italic in the brand gradient, after the heading.",
      "default": "You Shop."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Straightforward guides to THCA, terpenes, lab reports, flower and solventless concentrates."
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Pull newest articles from blog",
      "info": "Optional. When set, the three newest articles replace the cards below."
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show card images",
      "default": false
    },
    {
      "type": "text",
      "id": "card_link_label",
      "label": "Card link label",
      "default": "Read Guide"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All Guides"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Point this at the Knowledge Hub blog (/blogs/knowledge-hub)."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F9F7F4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Guide card",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Category label",
          "default": "THCA Basics"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "What Is THCA?"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Excerpt",
          "default": "The acidic precursor to delta-9 THC, and what it means on a lab report."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Sundaze Hub Preview",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "tag": "THCA Basics",
            "title": "What Is THCA?",
            "text": "The acidic precursor to delta-9 THC, and what it means on a lab report."
          }
        },
        {
          "type": "card",
          "settings": {
            "tag": "Lab + Care",
            "title": "How to Read a COA",
            "text": "Match the product, read the cannabinoid panel and check the safety panels."
          }
        },
        {
          "type": "card",
          "settings": {
            "tag": "Rosin / Hash",
            "title": "What Is Hash Rosin?",
            "text": "A solventless concentrate made with heat and pressure — and why that matters."
          }
        }
      ]
    }
  ]
}
{% endschema %}
