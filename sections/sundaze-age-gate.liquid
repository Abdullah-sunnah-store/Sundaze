<style>
.age-gate {
  position: fixed;
  top: 0; left: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  background: linear-gradient(to bottom, #fff5de, #ffe5dd);
  overflow-x: hidden;
  overflow-y: auto;
  z-index: 99999;
  transition: opacity 0.6s ease-out, transform 0.6s ease-out;
}

.age-gate.hidden { display: none !important; }

.age-gate.fade-out {
  opacity: 0;
  transform: translateY(-60px);
  pointer-events: none;
}

.tubes-container {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none; z-index: 1; overflow: hidden;
}

.falling-tube {
  position: absolute; top: -480px; left: var(--col, 6%);
  width: 220px; height: 360px;
  object-fit: contain; object-position: center;
  filter: drop-shadow(0 3px 8px rgba(0,0,0,0.08));
  animation: tubeFall var(--fd, 11s) linear var(--fdd, 0s) infinite, tubeWobble var(--wd, 3s) ease-in-out var(--wdd, 0s) infinite;
  transform-origin: center center; will-change: top, transform, opacity;
  pointer-events: none;
}

@keyframes tubeFall {
  0% { top: -480px; opacity: 0; } 5% { opacity: 1; } 92% { opacity: 1; } 100% { top: 110vh; opacity: 0; }
}
@keyframes tubeWobble {
  0% { transform: rotate(-9deg); } 25% { transform: rotate(9deg); } 50% { transform: rotate(-9deg); } 75% { transform: rotate(9deg); } 100% { transform: rotate(-9deg); }
}

.age-gate__content {
  position: relative; z-index: 10; display: flex; flex-direction: column;
  align-items: center; text-align: center; gap: 0;
  padding: 24px 20px; max-width: 720px; width: 100%;
  margin: auto 0;
}

.age-gate__logo { width: 440px; max-width: 80vw; display: block; filter: drop-shadow(0px 3px 10px rgba(0,0,0,0.12)); margin-bottom: 0px; pointer-events: none; }
.age-gate__tagline { font-family: Georgia, serif; font-style: normal; font-weight: 400; font-size: 17px; color: #5a3a2a; letter-spacing: 0.3px; margin-top: -80px; padding: 0; margin-bottom: 16px; pointer-events: none; }
.age-gate__row {
  display: flex; flex-direction: column; align-items: center; gap: 16px;
  width: 100%; justify-content: center; position: relative; z-index: 20;
}

/* ── Terms & Conditions card ── */
.age-gate__terms {
  width: 100%;
  max-width: 640px;
  text-align: left;
  background: rgba(255, 252, 244, 0.92);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid #f0ddc2;
  border-radius: 22px;
  box-shadow: 0 14px 40px rgba(93, 58, 34, 0.12);
  padding: 20px 8px 20px 24px;
}
.age-gate__terms-scroll {
  max-height: clamp(180px, 34vh, 340px);
  overflow-y: auto;
  padding-right: 16px;
  overscroll-behavior: contain;
}
.age-gate__terms-scroll::-webkit-scrollbar { width: 6px; }
.age-gate__terms-scroll::-webkit-scrollbar-track { background: rgba(232, 213, 190, 0.35); border-radius: 50px; }
.age-gate__terms-scroll::-webkit-scrollbar-thumb { background: #d8b48c; border-radius: 50px; }
.age-gate__terms-scroll::-webkit-scrollbar-thumb:hover { background: #c39a6d; }
.age-gate__terms-scroll { scrollbar-width: thin; scrollbar-color: #d8b48c rgba(232, 213, 190, 0.35); }

.age-gate__terms-title {
  font-family: Georgia, serif; font-weight: 700; font-size: 20px;
  color: #3d2314; letter-spacing: 0.2px; text-align: center;
  margin: 0 16px 4px 0; padding: 0;
}
.age-gate__terms-intro {
  font-family: Georgia, serif; font-size: 13px; line-height: 1.6;
  color: #6b4a35; text-align: center; margin: 0 16px 16px 0; padding: 0;
}
.age-gate__terms-rule {
  height: 1px; border: 0; margin: 0 16px 16px 0;
  background: linear-gradient(90deg, transparent, #e8d5be 20%, #e8d5be 80%, transparent);
}
.age-gate__terms h4 {
  font-family: Georgia, serif; font-size: 11.5px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.14em;
  color: #cf4d8a; margin: 0 0 6px; padding: 0;
}
.age-gate__terms p {
  font-family: Georgia, serif; font-size: 13px; line-height: 1.65;
  color: #5a3a2a; margin: 0 0 16px; padding: 0;
}
.age-gate__terms p:last-child { margin-bottom: 0; }
.age-gate__terms-states {
  display: block; margin-top: 6px;
  font-weight: 700; color: #a8452c; letter-spacing: 0.2px;
}

.age-gate__btn {
  padding: 14px 30px; background: #3d2314; color: #ffffff; border: none;
  border-radius: 50px; font-size: 14px; font-weight: 600; letter-spacing: 0.5px;
  cursor: pointer; transition: opacity 0.2s ease, transform 0.15s ease; font-family: Georgia, serif;
  white-space: nowrap; display: flex; align-items: center; gap: 8px;
  box-shadow: 0 4px 14px rgba(61, 35, 20, 0.22);
}
.age-gate__btn:hover { opacity: 0.9; transform: translateY(-1px); }
.age-gate__btn:active { transform: translateY(0); }
.age-gate__btn::after { content: '\2192'; font-size: 18px; line-height: 1; }

@media (max-width: 768px) {
  .falling-tube { width: 120px; height: 300px; }
  .age-gate__logo { width: 280px; margin-bottom: 34px; }
  .age-gate__tagline { font-size: 14px; margin-bottom: 12px; }
  .age-gate__row { gap: 14px; }
  .age-gate__terms { padding: 16px 6px 16px 18px; border-radius: 18px; }
  .age-gate__terms-scroll { max-height: clamp(160px, 32vh, 300px); padding-right: 12px; }
  .age-gate__terms-title { font-size: 17px; }
  .age-gate__terms-intro, .age-gate__terms p { font-size: 12.5px; }
  .age-gate__btn { width: 100%; max-width: 320px; justify-content: center; }
}
</style>

<div class="age-gate" id="sundazeAgeGate">
  <div class="tubes-container">
    {% if section.settings.tube_1 != blank %}<img class="falling-tube" src="{{ section.settings.tube_1 | img_url: '400x' }}" style="--col:6%;--fd:11s;--fdd:0s;--wd:3s;--wdd:0s" alt="">{% endif %}
    {% if section.settings.tube_3 != blank %}<img class="falling-tube" src="{{ section.settings.tube_3 | img_url: '400x' }}" style="--col:8%;--fd:11s;--fdd:3.7s;--wd:3.2s;--wdd:0.5s" alt="">{% endif %}
    {% if section.settings.tube_2 != blank %}<img class="falling-tube" src="{{ section.settings.tube_2 | img_url: '400x' }}" style="--col:5%;--fd:11s;--fdd:7.3s;--wd:2.8s;--wdd:1s" alt="">{% endif %}
    {% if section.settings.tube_2 != blank %}<img class="falling-tube" src="{{ section.settings.tube_2 | img_url: '400x' }}" style="--col:30%;--fd:11.8s;--fdd:0.8s;--wd:2.8s;--wdd:0.2s" alt="">{% endif %}
    {% if section.settings.tube_4 != blank %}<img class="falling-tube" src="{{ section.settings.tube_4 | img_url: '400x' }}" style="--col:28%;--fd:11.8s;--fdd:4.7s;--wd:3.1s;--wdd:0.7s" alt="">{% endif %}
    {% if section.settings.tube_1 != blank %}<img class="falling-tube" src="{{ section.settings.tube_1 | img_url: '400x' }}" style="--col:31%;--fd:11.8s;--fdd:8.6s;--wd:3s;--wdd:1.2s" alt="">{% endif %}
    {% if section.settings.tube_3 != blank %}<img class="falling-tube" src="{{ section.settings.tube_3 | img_url: '400x' }}" style="--col:57%;--fd:12.2s;--fdd:1.7s;--wd:3s;--wdd:0.4s" alt="">{% endif %}
    {% if section.settings.tube_1 != blank %}<img class="falling-tube" src="{{ section.settings.tube_1 | img_url: '400x' }}" style="--col:59%;--fd:12.2s;--fdd:5.8s;--wd:2.7s;--wdd:0.9s" alt="">{% endif %}
    {% if section.settings.tube_4 != blank %}<img class="falling-tube" src="{{ section.settings.tube_4 | img_url: '400x' }}" style="--col:56%;--fd:12.2s;--fdd:9.8s;--wd:3.2s;--wdd:0.3s" alt="">{% endif %}
    {% if section.settings.tube_4 != blank %}<img class="falling-tube" src="{{ section.settings.tube_4 | img_url: '400x' }}" style="--col:82%;--fd:11.5s;--fdd:2.3s;--wd:2.7s;--wdd:0.6s" alt="">{% endif %}
    {% if section.settings.tube_2 != blank %}<img class="falling-tube" src="{{ section.settings.tube_2 | img_url: '400x' }}" style="--col:80%;--fd:11.5s;--fdd:6.1s;--wd:3.1s;--wdd:0.1s" alt="">{% endif %}
    {% if section.settings.tube_3 != blank %}<img class="falling-tube" src="{{ section.settings.tube_3 | img_url: '400x' }}" style="--col:83%;--fd:11.5s;--fdd:10s;--wd:2.9s;--wdd:0.8s" alt="">{% endif %}
  </div>

  <div class="age-gate__content">
    {% if section.settings.logo != blank %}<img class="age-gate__logo" src="{{ section.settings.logo | img_url: '1000x' }}" alt="Sundaze">{% endif %}
    <p class="age-gate__tagline">{{ section.settings.tagline }}</p>
    <div class="age-gate__row">
      <div class="age-gate__terms">
        <div class="age-gate__terms-scroll" tabindex="0" role="region" aria-label="Terms and Conditions">
          <h3 class="age-gate__terms-title">{{ section.settings.terms_title | default: 'Terms &amp; Conditions' }}</h3>
          <p class="age-gate__terms-intro">By entering this website, you acknowledge and agree to the following:</p>
          <hr class="age-gate__terms-rule">

          <h4>21+ Only</h4>
          <p>You must be 21 years of age or older to access, browse, or purchase products from SUNDAZE. By entering the store, you confirm that you are at least 21 years old.</p>

          <h4>Age Verification</h4>
          <p>SUNDAZE reserves the right to verify your age and identity before processing or fulfilling an order. Orders that cannot be successfully age-verified may be canceled.</p>

          <h4>Shipping Restrictions</h4>
          <p>SUNDAZE does not ship to the following states:
            <span class="age-gate__terms-states">Arkansas, Idaho, Minnesota, Oregon, Rhode Island, Texas, and Vermont.</span>
          </p>
          <p>Orders with shipping addresses in these states will not be accepted or fulfilled.</p>

          <h4>Customer Responsibility</h4>
          <p>Laws and regulations regarding hemp-derived products vary by state and locality and may change over time. By entering this website or purchasing from SUNDAZE, you acknowledge that you are responsible for understanding and complying with all laws applicable to you and your location.</p>

          <h4>Agreement</h4>
          <p>By clicking the button below, you confirm that you are 21 years of age or older, that the information you provide is accurate, and that you agree to these Terms &amp; Conditions and SUNDAZE&rsquo;s applicable policies.</p>
        </div>
      </div>

      <button class="age-gate__btn" id="enterSiteBtn">{{ section.settings.button_text | default: 'Accept Terms &amp; Shop Now' }}</button>
    </div>
  </div>
</div>

<script>
  (function () {
    var ageGate = document.getElementById('sundazeAgeGate');
    if (!ageGate) return;

    if (sessionStorage.getItem('sundaze_verified')) {
      ageGate.classList.add('hidden');
      return;
    }

    var enterBtn = document.getElementById('enterSiteBtn');
    var redirectUrl = {{ section.settings.redirect_url | default: '' | json }};

    enterBtn.addEventListener('click', function () {
      sessionStorage.setItem('sundaze_verified', 'true');
      sessionStorage.setItem('sundaze_terms_accepted', new Date().toISOString());

      ageGate.classList.add('fade-out');

      setTimeout(function () {
        /* No redirect configured: the gate is an overlay on the page the
           shopper already asked for, so just get out of the way. */
        if (!redirectUrl) {
          ageGate.classList.add('hidden');
          return;
        }
        window.location.href = redirectUrl;
      }, 600);
    });
  })();
</script>

{% schema %}
{
  "name": "Age Gate",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Sundaze Logo" },
    { "type": "text", "id": "tagline", "label": "Tagline Text", "default": "Dont You Just Love Sundaze?" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Accept Terms & Shop Now" },
    { "type": "text", "id": "terms_title", "label": "Terms Box Heading", "default": "Terms & Conditions" },
    { "type": "url", "id": "redirect_url", "label": "Redirect URL after verification" },
    { "type": "image_picker", "id": "tube_1", "label": "Falling Product Image 1" },
    { "type": "image_picker", "id": "tube_2", "label": "Falling Product Image 2" },
    { "type": "image_picker", "id": "tube_3", "label": "Falling Product Image 3" },
    { "type": "image_picker", "id": "tube_4", "label": "Falling Product Image 4" }
  ],
  "presets": [{ "name": "Age Gate" }]
}
{% endschema %}