<!-- ════════════════════════════════════════════════════════════
     ALL JAVASCRIPT (unified — master case hero + product sections)
════════════════════════════════════════════════════════════ -->
<script>
(function () {

  /* ── TOAST ── */
  var Toast = {
    _t: null,
    show: function (msg, icon, type) {
      var el  = document.getElementById('hroToast');
      var txt = document.getElementById('hroToastMsg');
      var ico = document.getElementById('hroToastIcon');
      if (!el || !txt || !ico) return;
      el.className    = 'hro-toast ' + (type || '');
      txt.textContent = msg;
      ico.textContent = icon || '';
      el.classList.add('show');
      clearTimeout(this._t);
      this._t = setTimeout(function () { el.classList.remove('show'); }, 3000);
    }
  };

  /* ── CART BUBBLE ── */
  var CartBubble = {
    bubble: document.getElementById('hroCartBubble'),
    count:  document.getElementById('hroCartCount'),
    init: function () {
      if (!this.bubble) return;
      fetch('/cart.js').then(function (r) { return r.json(); }).then(function (d) { CartBubble.update(d.item_count); }).catch(function () {});
    },
    update: function (n) {
      /* update theme header cart count if it exists */
      fetch('/?section_id=cart-icon-bubble')
        .then(function (r) { return r.text(); })
        .then(function (html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var newContent = doc.getElementById('cart-icon-bubble') || doc.querySelector('.shopify-section') || doc.body;
          var oldBubble = document.getElementById('cart-icon-bubble');
          if (newContent && oldBubble) {
            oldBubble.innerHTML = newContent.innerHTML;
          }
        })
        .catch(function () {});

      if (!this.count || !this.bubble) return;
      this.count.textContent = n;
      if (n > 0) this.bubble.classList.add('show');
    }
  };

  /* ── WISHLIST BUBBLE ── */
  var WishBubble = {
    el:    document.getElementById('hroWishBubble'),
    count: document.getElementById('hroWishBubbleCount'),
    update: function (n) {
      if (!this.el || !this.count) return;
      this.count.textContent = n;
      this.count.classList.remove('bump');
      void this.count.offsetWidth;
      this.count.classList.add('bump');
      setTimeout(function () { if (WishBubble.count) WishBubble.count.classList.remove('bump'); }, 300);
    }
  };

  /* ── CART ADD (product page buttons) ── */
  var HroCart = {
    add: function (btn) {
      var variantId   = btn.dataset.variantId;
      var productName = btn.dataset.productName || 'Product';
      if (!variantId || variantId === '') {
        Toast.show('Variant not configured yet', '⚠️', 'error');
        return;
      }
      btn.disabled = true;
      btn.classList.add('loading');
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
      })
      .then(function (res) {
        if (!res.ok) return res.json().then(function (e) { throw new Error(e.description || 'Error'); });
        return res.json();
      })
      .then(function () {
        btn.classList.remove('loading');
        btn.classList.add('added');
        btn.querySelector('.hro-btn-text').textContent = 'Added!';
        Toast.show(productName + ' added to cart', '🛒', '');
        fetch('/cart.js').then(function (r) { return r.json(); }).then(function (d) { CartBubble.update(d.item_count); });
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        setTimeout(function () {
          btn.disabled = false;
          btn.classList.remove('added');
          btn.querySelector('.hro-btn-text').textContent = btn.dataset.originalText || 'Add to cart';
        }, 2500);
      })
      .catch(function (err) {
        btn.disabled = false;
        btn.classList.remove('loading');
        Toast.show(err.message || 'Could not add to cart', '❌', 'error');
      });
    }
  };
  window.HroCart = HroCart;

  /* ── WISHLIST ── */
  var WISH_KEY = 'sundaze_wishlist_v1';
  var HroWish = {
    _load: function () { try { return JSON.parse(localStorage.getItem(WISH_KEY) || '[]'); } catch (e) { return []; } },
    _save: function (list) { localStorage.setItem(WISH_KEY, JSON.stringify(list)); },
    _has:  function (id) { return this._load().some(function (i) { return i.id === id; }); },
    toggle: function (btn) {
      var id    = btn.dataset.variantId;
      var name  = btn.dataset.productName  || 'Product';
      var price = btn.dataset.productPrice || '';
      var img   = btn.dataset.productImage || '';
      var emoji = btn.dataset.productEmoji || '🍩';
      if (!id || id === '') { Toast.show('Variant not configured yet', '⚠️', 'error'); return; }
      var list = this._load();
      var idx  = list.findIndex(function (i) { return i.id === id; });
      if (idx === -1) {
        list.push({ id: id, name: name, price: price, img: img, emoji: emoji });
        this._save(list);
        this._setWished(btn, true);
        Toast.show(name + ' wishlisted', '💗', 'wish');
      } else {
        list.splice(idx, 1);
        this._save(list);
        this._setWished(btn, false);
        Toast.show('Removed from wishlist', '🤍', '');
      }
      WishBubble.update(this._load().length);
      this._renderDrawer();
    },
    _setWished: function (btn, wished) {
      if (wished) btn.classList.add('wished'); else btn.classList.remove('wished');
      btn.classList.add('wish-pop');
      setTimeout(function () { btn.classList.remove('wish-pop'); }, 250);
    },
    initButtons: function () {
      var self = this;
      document.querySelectorAll('.hro-wish-btn').forEach(function (btn) {
        if (btn.dataset.variantId && self._has(btn.dataset.variantId)) btn.classList.add('wished');
      });
    },
    openDrawer: function () {
      var overlay = document.getElementById('hroWishOverlay');
      var drawer = document.getElementById('hroWishDrawer');
      if (!overlay || !drawer) return;
      this._renderDrawer();
      overlay.classList.add('open');
      drawer.classList.add('open');
      document.body.style.overflow = 'hidden';
    },
    closeDrawer: function () {
      var overlay = document.getElementById('hroWishOverlay');
      var drawer = document.getElementById('hroWishDrawer');
      if (!overlay || !drawer) return;
      overlay.classList.remove('open');
      drawer.classList.remove('open');
      document.body.style.overflow = '';
    },
    _renderDrawer: function () {
      var list      = this._load();
      var container = document.getElementById('hroWishList');
      if (!container) return;
      if (list.length === 0) {
        container.innerHTML = '<div class="hro-drawer-empty"><div class="hro-drawer-empty-icon">🤍</div><p>Your wishlist is empty</p><p style="font-size:12px;opacity:.6">Tap the heart on any product to save it here</p></div>';
        return;
      }
      container.innerHTML = list.map(function (item) {
        return (
          '<div class="hro-wish-item" data-wish-id="' + item.id + '">' +
            (item.img
              ? '<img class="hro-wish-item-img" src="' + item.img + '" alt="' + item.name + '">'
              : '<div class="hro-wish-item-img-placeholder">' + item.emoji + '</div>') +
            '<div class="hro-wish-item-info">' +
              '<p class="hro-wish-item-name">' + item.name + '</p>' +
              '<p class="hro-wish-item-price">' + item.price + '</p>' +
              '<div class="hro-wish-item-actions">' +
                '<button class="hro-wish-add-btn" onclick="HroWish._addFromDrawer(\'' + item.id + '\',\'' + item.name + '\',this)">Add to cart</button>' +
                '<button class="hro-wish-remove-btn" onclick="HroWish._removeFromDrawer(\'' + item.id + '\')">Remove</button>' +
              '</div>' +
            '</div>' +
          '</div>'
        );
      }).join('');
    },
    _addFromDrawer: function (id, name, btn) {
      if (!id) return;
      btn.textContent = 'Adding…'; btn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: parseInt(id, 10), quantity: 1 })
      })
      .then(function (res) { if (!res.ok) throw new Error(); return res.json(); })
      .then(function () {
        btn.textContent = '✓ Added!';
        Toast.show(name + ' added to cart', '🛒', '');
        fetch('/cart.js').then(function (r) { return r.json(); }).then(function (d) { CartBubble.update(d.item_count); });
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        setTimeout(function () { btn.textContent = 'Add to cart'; btn.disabled = false; }, 2000);
      })
      .catch(function () { btn.textContent = 'Error'; btn.disabled = false; });
    },
    _removeFromDrawer: function (id) {
      var list = this._load().filter(function (i) { return i.id !== id; });
      this._save(list);
      document.querySelectorAll('.hro-wish-btn[data-variant-id="' + id + '"]').forEach(function (b) { b.classList.remove('wished'); });
      WishBubble.update(list.length);
      this._renderDrawer();
    }
  };
  window.HroWish = HroWish;

  /* ── ACCORDION (product page) ── */
  function hroToggleAccordion(btn) {
    var body   = btn.nextElementSibling;
    var isOpen = btn.classList.contains('open');
    if (isOpen) { btn.classList.remove('open'); body.classList.remove('open'); }
    else         { btn.classList.add('open');    body.classList.add('open');    }
  }
  window.hroToggleAccordion = hroToggleAccordion;

  /* ── ACCORDION (master case hero right column) ── */
  document.querySelectorAll('#hro-combined-{{ section.id }} [data-hrp-acc]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var acc    = btn.closest('.hrp-acc');
      var isOpen = acc.classList.contains('hrp-acc--open');
      var icon   = btn.querySelector('.hrp-acc__icon');
      /* toggle only this accordion — others stay as they are */
      if (isOpen) {
        acc.classList.remove('hrp-acc--open');
        if (icon) icon.classList.remove('hrp-acc__icon--open');
      } else {
        acc.classList.add('hrp-acc--open');
        if (icon) icon.classList.add('hrp-acc__icon--open');
      }
    });
  });

  /* ── MASTER CASE HERO — FLAVOR SELECTOR ── */
  var sid         = '{{ section.id }}';
  var vidInput    = document.getElementById('hrp-vid-'    + sid);
  var priceEl     = document.getElementById('hrp-price-'  + sid);
  var subEl       = document.getElementById('hrp-sub-'    + sid);
  var descEl      = document.getElementById('hrp-desc-'   + sid);
  var labelEl     = document.getElementById('hrp-label-'  + sid);
  var pill1El     = document.getElementById('hrp-pill1-'  + sid);
  var pill2El     = document.getElementById('hrp-pill2-'  + sid);
  var jarsEl      = document.getElementById('hrp-jars-'   + sid);
  var accDescEl   = document.getElementById('hrp-acc-desc-'   + sid);
  var accFlavorEl = document.getElementById('hrp-acc-flavor-' + sid);
  var accSpecsEl  = document.getElementById('hrp-acc-specs-'  + sid);
  var accHighlightEl = document.getElementById('hrp-acc-highlight-' + sid);
  var optBtns     = document.querySelectorAll('#hro-combined-' + sid + ' [data-hrp-opt]');

  var caseImageMixed = '{{ img_case_mixed }}';

  function makeImg(src, alt, cls) {
    if (!src) return '';
    return '<img src="' + src + '" alt="' + (alt || '') + '" class="' + cls + '" loading="lazy">';
  }

  function renderJars(btn) {
    var imgSrc = btn.dataset.image || (btn.dataset.mode === 'mixed' ? caseImageMixed : '');
    if (!jarsEl) return;
    jarsEl.innerHTML = '';
    if (imgSrc) jarsEl.innerHTML = makeImg(imgSrc, btn.dataset.label, 'hrp-jar hrp-jar--single');
  }

  optBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      optBtns.forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      if (vidInput    && btn.dataset.variant)    vidInput.value          = btn.dataset.variant;
      if (priceEl     && btn.dataset.price)       priceEl.textContent     = btn.dataset.price;
      if (subEl       && btn.dataset.sub)         subEl.textContent       = btn.dataset.sub;
      if (descEl      && btn.dataset.desc)        descEl.textContent      = btn.dataset.desc;
      if (labelEl     && btn.dataset.label)       labelEl.textContent     = btn.dataset.label;
      if (pill1El     && btn.dataset.pill)        pill1El.textContent     = btn.dataset.pill;
      if (pill2El     && btn.dataset.pill2)       pill2El.textContent     = btn.dataset.pill2;
      
      if (accDescEl)   accDescEl.textContent   = btn.dataset.accDesc   || '';
      if (accFlavorEl) accFlavorEl.textContent = btn.dataset.accFlavor || '';

      if (accSpecsEl) {
        accSpecsEl.innerHTML = btn.dataset.accSpecs || '';
      }
      if (accHighlightEl) {
        accHighlightEl.textContent = btn.dataset.accHighlight || '';
      }

      /* ── SWAP ROSIN CLOSE-UP IMAGES ── */
      var newRosin = btn.dataset.rosinImg;
      if (newRosin) {
        var miniImg = document.getElementById('hrp-rosin-mini-' + sid);
        var featImg = document.getElementById('hrp-rosin-feat-' + sid);
        if (miniImg && miniImg.tagName === 'IMG') miniImg.src = newRosin;
        if (featImg && featImg.tagName === 'IMG') featImg.src = newRosin;
      }

      /* ── SWAP LID ICON ── */
      var newLid = btn.dataset.lidImg;
      if (newLid) {
        var lidImg = document.getElementById('hrp-lid-icon-' + sid);
        if (lidImg && lidImg.tagName === 'IMG') lidImg.src = newLid;
      }

      /* ── SWAP WISHLIST DATA ── */
      var mainWish = document.getElementById('hrp-wish-' + sid);
      if (mainWish) {
        mainWish.dataset.variantId    = btn.dataset.variant || '';
        mainWish.dataset.productName  = btn.dataset.pill || '';
        mainWish.dataset.productPrice = btn.dataset.price || '';
        mainWish.dataset.productImage = btn.dataset.image || '';
        
        if (HroWish._has(mainWish.dataset.variantId)) {
          mainWish.classList.add('wished');
          mainWish.textContent = '♥';
          mainWish.style.color = '#ec4f9a';
          mainWish.style.borderColor = '#ec4f9a';
        } else {
          mainWish.classList.remove('wished');
          mainWish.textContent = '♡';
          mainWish.style.color = '';
          mainWish.style.borderColor = '';
        }
      }

      renderJars(btn);
    });
  });

  /* ── MASTER CASE HERO — ASYNC ATC ── */
  var heroForm = document.querySelector('#hro-combined-' + sid + ' [data-hrp-form]');

  /* ── MIXED CASE FLAVOR PICKER ──
     Four steppers sharing one cap. The counts are mirrored into hidden
     properties[<flavor>] inputs on the cart form; a flavor at 0 is written as
     an empty string, which Shopify drops, so only chosen flavors reach the
     order. The whole block only applies to the mixed case — picking a single
     flavor clears every property. */
  var MixPicker = {
    el:     document.getElementById('hrp-mix-' + sid),
    active: false,
    qty:    [],
    max:    4,

    init: function () {
      if (!this.el || !heroForm) return;
      var self = this;

      this.max   = parseInt(this.el.dataset.max, 10) || 4;
      this.props = heroForm.querySelectorAll('[data-hrp-mix-prop]');
      this.qtyEls   = this.el.querySelectorAll('[data-hrp-mix-qty]');
      this.meterEl  = this.el.querySelector('[data-hrp-mix-meter]');
      this.hintEl   = this.el.querySelector('[data-hrp-mix-hint]');
      this.atcBtn   = heroForm.querySelector('[type="submit"]');
      this.atcLabel = this.atcBtn ? this.atcBtn.innerHTML : '';

      // Default to one of each — the standard four-flavor case.
      this.qty = [];
      for (var i = 0; i < this.qtyEls.length; i++) {
        this.qty.push(i < this.max ? 1 : 0);
      }

      this.el.querySelectorAll('[data-hrp-mix-step]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          self.step(
            parseInt(btn.dataset.hrpMixIndex, 10),
            parseInt(btn.dataset.hrpMixStep, 10)
          );
        });
      });

      // The starting option is the mixed case, so open with the picker on.
      var current = document.querySelector('#hro-combined-' + sid + ' [data-hrp-opt].active');
      this.setActive(!current || current.dataset.mode === 'mixed');
    },

    total: function () {
      return this.qty.reduce(function (a, b) { return a + b; }, 0);
    },

    step: function (index, delta) {
      if (isNaN(index) || isNaN(delta)) return;
      var next = this.qty[index] + delta;
      if (next < 0 || (delta > 0 && this.total() >= this.max)) return;
      this.qty[index] = next;
      this.render();
    },

    setActive: function (on) {
      if (!this.el || !this.props) return;
      this.active = !!on;
      this.el.classList.toggle('is-visible', this.active);
      this.render();
    },

    render: function () {
      if (!this.el || !this.props) return;
      var self  = this;
      var total = this.total();
      var left  = this.max - total;

      this.qtyEls.forEach(function (span, i) { span.textContent = self.qty[i]; });

      this.el.querySelectorAll('[data-hrp-mix-step]').forEach(function (btn) {
        var i = parseInt(btn.dataset.hrpMixIndex, 10);
        var d = parseInt(btn.dataset.hrpMixStep, 10);
        btn.disabled = d > 0 ? left <= 0 : self.qty[i] <= 0;
      });

      if (this.meterEl) this.meterEl.textContent = total + ' of ' + this.max + ' selected';
      if (this.hintEl) {
        this.hintEl.textContent = this.active && left > 0
          ? 'Add ' + left + ' more jar' + (left === 1 ? '' : 's') + ' to complete the case.'
          : '';
      }

      // Only the mixed case carries flavor properties. Disabled inputs are left
      // out of FormData entirely, so a flavor at 0 can't reach the order even if
      // blank-value properties were ever accepted.
      this.props.forEach(function (input, i) {
        var chosen = self.active && self.qty[i] > 0;
        input.value    = chosen ? String(self.qty[i]) : '';
        input.disabled = !chosen;
      });

      if (this.atcBtn) {
        var blocked = this.active && total !== this.max;
        this.atcBtn.disabled = blocked;
        this.atcBtn.innerHTML = blocked
          ? 'Choose ' + this.max + ' jars'
          : this.atcLabel;
      }
    }
  };
  MixPicker.init();

  // Show the picker only while the mixed case is the selected option.
  optBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      MixPicker.setActive(btn.dataset.mode === 'mixed');
    });
  });

  if (heroForm) {
    heroForm.addEventListener('submit', function (e) {
      e.preventDefault();
      if (MixPicker.active && MixPicker.total() !== MixPicker.max) return;
      var btn  = heroForm.querySelector('[type="submit"]');
      var orig = btn.innerHTML;
      btn.textContent = 'Adding…';
      btn.disabled    = true;
      fetch('/cart/add.js', { method: 'POST', body: new FormData(heroForm) })
        .then(function (r) {
          if (!r.ok) throw new Error('cart error');
          btn.innerHTML = '<span class="hrp-atc__check">✓</span> Added!';
          btn.style.background = '#2a7a4b';
          Toast.show('Added to cart', '🛒', '');
          fetch('/cart.js').then(function (r2) { return r2.json(); }).then(function (d) { CartBubble.update(d.item_count); });
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          setTimeout(function () {
            btn.innerHTML        = orig;
            btn.style.background = '';
            btn.disabled         = false;
          }, 1800);
        })
        .catch(function () {
          HTMLFormElement.prototype.submit.call(heroForm);
        });
    });
  }

  /* ── MASTER CASE HERO — WISH BUTTON (plain heart toggle) ── */
  document.querySelectorAll('#hro-combined-' + sid + ' .hrp-wish').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var wished          = btn.dataset.wished === '1';
      btn.dataset.wished  = wished ? '0' : '1';
      btn.textContent     = wished ? '♡' : '♥';
      btn.style.color     = wished ? '' : '#ec4f9a';
      btn.style.borderColor = wished ? '' : '#ec4f9a';
    });
  });

  /* ── LIVE VIEWERS — MASTER CASE HERO ── */
  var CaseLive = {
    badge:   document.getElementById('hrpCaseLiveBadge'),
    countEl: document.getElementById('hrpCaseLiveCount'),
    wsUrl:   'wss://sundaze-live-viewers.mamunhossain-services.workers.dev',
    _fallbackTimer: null,
    init: function () {
      if (!this.badge) return;
      this.connectWebSocket();
    },
    connectWebSocket: function () {
      var self = this;
      try {
        var ws = new WebSocket(this.wsUrl);
        ws.onopen    = function () { self.badge.classList.add('hrp-live-visible'); clearInterval(self._fallbackTimer); };
        ws.onmessage = function (event) {
          try { var d = JSON.parse(event.data); if (d.type === 'count') self.updateCount(d.count); } catch (ex) {}
        };
        ws.onerror = function () { self.fallbackSimulation(); };
        ws.onclose = function () { self.fallbackSimulation(); };
      } catch (ex) { this.fallbackSimulation(); }
    },
    updateCount: function (count) {
      if (count > 0 && this.countEl) { this.countEl.textContent = count; this.badge.classList.add('hrp-live-visible'); }
    },
    fallbackSimulation: function () {
      if (this._fallbackTimer) return;
      var self = this;
      this.badge.classList.add('hrp-live-visible');
      var v = Math.floor(Math.random() * 24) + 14;
      this.updateCount(v);
      this._fallbackTimer = setInterval(function () {
        v = Math.max(8, v + Math.floor(Math.random() * 5) - 2);
        self.updateCount(v);
      }, 3500);
    }
  };

  /* ── SCROLL REVEAL ── */
  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) e.target.classList.add('visible');
    });
  }, { threshold: 0.08 });

  document.querySelectorAll(
    '#hro-combined-' + sid + ' .hro-card, ' +
    '#hro-combined-' + sid + ' .hro-section, ' +
    '#hro-combined-' + sid + ' .hro-animate, ' +
    '#hro-combined-' + sid + ' .hro-left, ' +
    '#hro-combined-' + sid + ' .hro-right'
  ).forEach(function (el) { observer.observe(el); });

  /* ── WISHLIST DRAWER EVENTS ── */
  var closeBtn = document.getElementById('hroDrawerClose');
  if (closeBtn) closeBtn.addEventListener('click', function () { HroWish.closeDrawer(); });
  var overlayEl = document.getElementById('hroWishOverlay');
  if (overlayEl) overlayEl.addEventListener('click', function () { HroWish.closeDrawer(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') HroWish.closeDrawer(); });

  /* ── CART REFRESH LISTENER ── */
  document.addEventListener('cart:refresh', function () {
    /* intentionally empty — cart count updated directly after each ATC call */
  });

  /* ── INIT ── */
  document.querySelectorAll('.hro-add-btn').forEach(function (btn) {
    var textEl = btn.querySelector('.hro-btn-text');
    if (textEl) btn.dataset.originalText = textEl.textContent;
  });

  CartBubble.init();
  HroWish.initButtons();
  if (WishBubble.el) WishBubble.update(HroWish._load().length);
  CaseLive.init();

})();
</script>

{%- if hide_until_cta -%}
<script>
/* ── REVEAL ON "SORBETTO COLLECTION" CTA CLICK ──
   The whole product block stays hidden until a link pointing at #sorbetto
   is clicked (the collection card), or the page is opened with that hash. */
(function () {
  var ANCHOR = 'sorbetto';
  var wrap = document.getElementById('hro-combined-{{ section.id }}');
  if (!wrap) return;

  /* Always visible inside the theme editor so it stays editable. */
  if (window.Shopify && window.Shopify.designMode) {
    wrap.classList.remove('hro-gated');
    return;
  }

  function currentHash() {
    return (window.location.hash || '').replace('#', '');
  }

  function scrollToAnchor() {
    var target = document.getElementById(ANCHOR) || wrap;
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function reveal(doScroll) {
    var wasHidden = wrap.classList.contains('hro-gated');
    wrap.classList.remove('hro-gated');
    if (wasHidden) window.dispatchEvent(new Event('resize'));
    if (doScroll) {
      requestAnimationFrame(function () { requestAnimationFrame(scrollToAnchor); });
    }
  }

  /* Landed on the page with #sorbetto already in the URL. */
  if (currentHash() === ANCHOR) reveal(true);

  window.addEventListener('hashchange', function () {
    if (currentHash() === ANCHOR) reveal(true);
  });

  document.addEventListener('click', function (e) {
    var link = e.target && e.target.closest ? e.target.closest('a[href]') : null;
    if (!link) return;

    var href = link.getAttribute('href') || '';
    var hashAt = href.indexOf('#');
    if (hashAt === -1 || href.slice(hashAt + 1) !== ANCHOR) return;

    /* Links to another page keep their normal navigation — the hash check
       above will reveal the block once that page loads. */
    var path = href.slice(0, hashAt).replace(/\/$/, '');
    var here = window.location.pathname.replace(/\/$/, '');
    if (path && path !== here) return;

    e.preventDefault();
    if (currentHash() !== ANCHOR) {
      history.pushState(null, '', '#' + ANCHOR);
    }
    reveal(true);
  });
})();
</script>
{%- endif -%}


