<!-- ════════════════════════════════════════════════════════════
     SHARED STYLES (Playfair Display + DM Sans fonts + variant pill bar)
════════════════════════════════════════════════════════════ -->
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,700&family=DM+Sans:wght@300;400;500;600&display=swap');

  /* ── BUCKET HERO CARD ── */
  /* Width/radius/shadow are kept in step with the flavor .hro-card below so the
     master case reads as the first card in one stack, not a separate banner.
     isolation: isolate keeps the card's inner z-indexes (hero top 3, live
     badge 4, jars 2) local — without it they land in the root stacking
     context and paint over the sticky header's dropdown, which sits at 4. */
  .hrp-shell {
    background: #fff;
    border-radius: 24px;
    max-width: 1232px;
    margin: 0 auto;
    width: 100%;
    box-shadow: 0 25px 50px rgba(0,0,0,.05);
    overflow: hidden;
    isolation: isolate;
    font-family: 'DM Sans', sans-serif;
    color: #111;
  }

  .hrp-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    align-items: stretch;
  }

  /* LEFT */
  .hrp-left { padding: 40px 0 40px 40px; display: flex; flex-direction: column; justify-content: center; }

  /* word-break: normal overrides the global h1–h5 break-word from base.css, so a
     long title wraps between words instead of splitting one. */
  .hrp-title { margin: 0 0 14px; line-height:1; letter-spacing: -.03em; word-break: normal; overflow-wrap: normal; hyphens: none; }
  .hrp-title__top {
    display: block;
    font-size: clamp(32px,2.9vw,46px);
    font-weight: 900;
    font-family: 'Playfair Display', serif;
    color: #111;
  }
  .hrp-title__gradient {
    display: block;
    font-size: clamp(32px,2.9vw,46px);
    font-weight: 900;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    background: linear-gradient(90deg,#ec4f9a 0%,#f099bd 30%,#b57938 72%,#2a1b14 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hrp-flavor-sub {
    font-size: 15px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    color: #e8357a;
    margin: 0 0 18px;
    letter-spacing: 0.04em;
  }
  .hrp-price {
    font-size: 30px;
    font-weight: 700;
    font-family: 'Playfair Display', serif;
    letter-spacing: -.03em;
    background: linear-gradient(90deg,#ec4f9a 0%,#f099bd 30%,#b57938 72%,#2a1b14 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    margin-bottom: 14px;
  }
  .hrp-desc {
    font-size: 14px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    color: #444;
    line-height: 1.65;
    margin-bottom: 18px;
    max-width: 100%;
  }
  .hrp-choose-label {
    font-size: 11px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(107,66,38,0.6);
    margin-bottom: 12px;
  }

  .hrp-options { display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 20px; }
  .hrp-opt {
    border: 1.5px solid #d8d8d8;
    background: #fff;
    color: #111;
    border-radius: 999px;
    padding: 9px 15px;
    font-size: 12.5px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: border-color .15s, background .15s, color .15s, box-shadow .15s;
    line-height: 1.25;
    text-align: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: normal;
    max-width: 100%;
  }
  .hrp-opt:hover { border-color: #999; }
  .hrp-opt.active {
    background: #111;
    color: #fff;
    border-color: #111;
    box-shadow: 0 6px 18px rgba(0,0,0,.22);
  }

  /* Master-case CTA row — kept identical in size to the flavor sections' .hro-actions row */
  .hrp-actions { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
  .hrp-actions form { flex: 1; display: flex; min-width: 0; }
  /* ── Mixed case flavor picker ── */
  .hrp-mix {
    display: none;
    margin: 0 0 18px;
    padding: 13px 15px 11px;
    border: 1.5px solid #f0d3e0;
    border-radius: 18px;
    background: #fffafc;
  }
  .hrp-mix.is-visible { display: block; }

  .hrp-mix__label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin: 0 0 9px;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a8a8a;
  }
  .hrp-mix__meter { color: #ec4f9a; white-space: nowrap; }

  .hrp-mix__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 5px 0;
    border-top: 1px solid #f6e6ee;
  }
  .hrp-mix__row:first-of-type { border-top: none; }

  .hrp-mix__name {
    font-family: 'DM Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 500;
    color: #111;
    line-height: 1.3;
  }

  .hrp-mix__stepper {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .hrp-mix__btn {
    width: 26px; height: 26px;
    display: inline-flex; align-items: center; justify-content: center;
    padding: 0;
    border: 1.5px solid #e6c8d8;
    border-radius: 50%;
    background: #fff;
    color: #b8426e;
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    transition: border-color .15s, background .15s, color .15s, opacity .15s;
  }
  .hrp-mix__btn:hover:not(:disabled) { border-color: #ec4f9a; background: #fff0f6; }
  .hrp-mix__btn:disabled { opacity: 0.35; cursor: not-allowed; }
  .hrp-mix__btn:focus-visible { outline: 2px solid #ec4f9a; outline-offset: 2px; }

  .hrp-mix__qty {
    min-width: 26px;
    text-align: center;
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #111;
  }

  .hrp-mix__hint {
    margin: 8px 0 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: #b8426e;
    min-height: 0;
  }

  .hrp-atc:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .hrp-atc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 1;
    background: #1a1a1a;
    color: #fff;
    border: 2px solid #1a1a1a;
    border-radius: 50px;
    padding: 12px 24px;
    font-size: 12px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .2s ease, transform .1s ease, box-shadow .2s ease;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    white-space: nowrap;
  }
  .hrp-atc:hover { background: #333; border-color: #333; transform: scale(1.03); box-shadow: 0 8px 24px rgba(0,0,0,0.2); }
  .hrp-atc:active { transform: scale(0.97); }
  .hrp-atc__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    flex-shrink: 0;
  }
  .hrp-wish {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid #e8e0d8;
    background: transparent;
    font-size: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color .2s ease, background .2s ease, transform .15s ease, color .2s ease;
    color: rgba(107,66,38,0.4);
    flex-shrink: 0;
  }
  .hrp-wish:hover { border-color: #e8a0bf; background: #fef0f5; color: #e8a0bf; transform: scale(1.1); }
  .hrp-wish:active { transform: scale(0.9); }
  .hrp-wish.wished { border-color: #e8a0bf; background: #fef0f5; color: #e8a0bf; }

  .hrp-mini-card {
    display: flex;
    align-items: center;
    gap: 14px;
    border: 1.5px solid #f5c8d8;
    border-radius: 20px;
    padding: 11px 14px;
    background: #fff8fa;
    max-width: 100%;
    margin-top: auto;
  }
  .hrp-mini-card__img { width: 58px; height: 58px; object-fit: cover; border-radius: 50%; flex-shrink: 0; }
  .hrp-mini-card__text { flex: 1; min-width: 0; }
  .hrp-mini-card__text strong {
    display: block;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    color: #7c431b;
    font-size: 15px;
    letter-spacing: -.01em;
    line-height: 1.1;
  }
  .hrp-mini-card__text b {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    color: #cf4d8a;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 3px;
  }
  .hrp-mini-card__text small {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    color: #6b5a50;
    font-size: 11.5px;
    margin-top: 4px;
  }

  .hrp-dot-grid {
    background: radial-gradient(circle, #ead4a9 0%, #c69959 100%);
    border-radius: 50%;
    display: grid;
    grid-template-columns: repeat(4,1fr);
    flex-shrink: 0;
  }
  .hrp-dot-grid span { background: #ee9abe; border-radius: 50%; display: block; aspect-ratio: 1; }
  .hrp-dot-grid--sm { width: 66px; height: 66px; gap: 4px; padding: 9px; border: 5px solid #f4e3c4; }
  .hrp-dot-grid--lg { width: 80px; height: 80px; gap: 4px; padding: 10px; border: 5px solid #f4e3c4; }

  /* CENTER */
  .hrp-center { padding: 20px; display: flex; flex-direction: column; }
  .hrp-hero-card {
    flex: 1;
    border-radius: 24px;
    padding: 24px 24px 20px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    min-height: 380px;
    background:
      radial-gradient(circle at 10% 14%, rgba(255,213,166,.92), transparent 32%),
      radial-gradient(circle at 76% 16%, rgba(255,177,215,.88), transparent 36%),
      radial-gradient(circle at 52% 90%, rgba(255,237,179,.92), transparent 40%),
      linear-gradient(135deg, #ffe9c9 0%, #ffc7dc 48%, #fff0bf 100%);
  }

  .hrp-hero-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    position: relative;
    z-index: 3;
  }
  .hrp-selected-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: rgba(255,255,255,.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 13px 20px;
    border-radius: 999px;
    box-shadow: 0 8px 24px rgba(0,0,0,.08);
    font-size: 13px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    letter-spacing: 0.04em;
    color: #111;
    white-space: nowrap;
  }
  .hrp-selected-pill__check {
    width: 24px;
    height: 24px;
    background: #ddaa61;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: #fff;
    font-weight: 600;
    flex-shrink: 0;
  }

  .hrp-live-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 50px;
    padding: 8px 14px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    font-size: 12px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    color: #1a1a1a;
    width: fit-content;
    margin-top: 12px;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    position: relative;
    z-index: 4;
  }
  .hrp-live-badge.hrp-live-visible { opacity: 1; transform: translateY(0); }
  .hrp-live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    flex-shrink: 0;
    box-shadow: 0 0 0 0 rgba(16,185,129,0.7);
    animation: hrp-pulse-dot 1.5s infinite ease-in-out;
  }
  @keyframes hrp-pulse-dot {
    0%   { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16,185,129,0.7); }
    70%  { transform: scale(1);    box-shadow: 0 0 0 6px rgba(16,185,129,0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16,185,129,0); }
  }

  .hrp-jars {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    padding-top: 4px;
    padding-bottom: 8px;
    min-height: 200px;
  }
  .hrp-jar { height: auto; object-fit: contain; filter: drop-shadow(0 20px 18px rgba(81,45,22,.18)); transition: opacity .3s, transform .3s; }
  .hrp-jar--l { height: clamp(180px,22vw,280px); }
  .hrp-jar--c { z-index: 2; height: clamp(200px,24vw,300px); position: relative; transform: translateY(-16px); }
  .hrp-jar--r { height: clamp(180px,22vw,280px); }
  .hrp-jar--single { width: 100%; max-width: 100%; height: 100%; max-height: 320px; object-fit: contain; transform: translateY(-8px); }

  .hrp-feat-card {
    background: rgba(255,248,236,.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 20px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 8px 28px rgba(0,0,0,.07);
    border: 1px solid rgba(255,220,180,.5);
    max-width: 380px;
    margin: 14px auto;
    position: relative;
    z-index: 3;
  }
  .hrp-feat-card__img { width: 68px; height: 68px; object-fit: cover; border-radius: 50%; flex-shrink: 0; }
  .hrp-feat-card__text { flex: 1; min-width: 0; }
  .hrp-feat-card__text strong {
    display: block;
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    color: #7c431b;
    font-size: 15px;
    letter-spacing: -.01em;
    line-height: 1.1;
  }
  .hrp-feat-card__text b {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    color: #cf4d8a;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 3px;
  }
  .hrp-feat-card__text small {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    color: #6b5244;
    font-size: 11px;
    margin-top: 3px;
  }
  .hrp-feat-card__divider { width: 1px; height: 48px; background: rgba(160,100,50,.25); flex-shrink: 0; display: block !important; }
  .hrp-feat-card__bucket { display: flex !important; align-items: center; justify-content: center; flex-shrink: 0; color: #9d6638; }
  .hrp-feat-card__bucket-img { width: 54px; height: 54px; object-fit: contain; }
  .hrp-bucket-svg { width: 54px; height: 54px; }

  .hrp-bottom-pills {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-top: 18px;
    position: relative;
    z-index: 3;
    flex-wrap: nowrap;
  }
  .hrp-pill {
    background: rgba(255,255,255,.86);
    padding: 14px 24px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    font-family: 'DM Sans', sans-serif;
    letter-spacing: 0.08em;
    box-shadow: 0 12px 28px rgba(0,0,0,.07);
    color: #111;
    white-space: nowrap;
  }

  /* RIGHT */
  .hrp-right { padding: 40px 40px 40px 0; display: flex; flex-direction: column; justify-content: center; }
  .hrp-acc { border-bottom: 1px solid #e8e8e8; }
  .hrp-acc__btn {
    width: 100%;
    border: none;
    background: transparent;
    padding: 22px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 18px;
    font-weight: 700;
    font-family: 'Playfair Display', serif;
    cursor: pointer;
    color: #3f2417;
    letter-spacing: -.01em;
    text-align: left;
    transition: color .15s;
  }
  .hrp-acc__btn:hover { color: #6b4226; }
  .hrp-acc__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: #999;
  }
  .hrp-acc__icon--open { transform: rotate(180deg); }
  /* Smooth slide — replaces display:none/block */
  .hrp-acc__panel {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.35s ease, opacity 0.3s ease;
    padding: 0;
  }
  .hrp-acc--open .hrp-acc__panel {
    max-height: 600px;
    opacity: 1;
    padding: 0 0 22px;
  }
  .hrp-acc__panel p {
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    font-size: 14px;
    line-height: 1.82;
    color: rgba(107,66,38,0.8);
  }
  .hrp-acc__panel ul { list-style: none; padding: 0; margin: 0; }
  .hrp-acc__panel li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 300;
    font-family: 'DM Sans', sans-serif;
    color: rgba(63,36,23,0.8);
    line-height: 1.6;
  }
  .hrp-acc__panel li::before {
    content: '';
    width: 6px;
    height: 6px;
    background: #d39a59;
    border-radius: 50%;
    position: absolute;
    left: 0;
    top: 7px;
  }
  .hrp-acc__highlight {
    font-family: 'DM Sans', sans-serif;
    color: #d94e8f;
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-top: 16px;
    font-size: 13px;
  }

  /* RESPONSIVE */
  @media screen and (max-width: 1200px) {
    .hrp-left  { padding: 32px 20px 32px 28px; }
    .hrp-right { padding: 32px 28px 32px 20px; }
  }
  @media screen and (max-width: 1023px) {
    .hrp-grid { grid-template-columns: 1fr; }
    .hrp-center { order: 1; }
    .hrp-left  { order: 2; border-bottom: 1px solid #f0ebe4; }
    .hrp-right { order: 3; border-top: 1px solid #f0ebe4; }
    .hrp-desc  { max-width: 100%; }
    .hrp-mini-card { max-width: 100%; }
  }
  @media screen and (max-width: 639px) {
    #sorbetto { padding: 24px 16px 32px !important; }
  }
  @media screen and (max-width: 600px) {
    .hrp-jar--l, .hrp-jar--r { height: 130px; }
    .hrp-jar--c { height: 150px; transform: translateY(-12px); }
    .hrp-jar--single { max-height: 200px; max-width: 100%; width: 100%; }
    .hrp-hero-card { border-radius: 28px; padding: 20px 18px; min-height: auto; }
    .hrp-jars    { min-height: 200px; padding-top: 8px; }
    .hrp-bottom-pills { flex-wrap: wrap; gap: 10px; margin-top: 14px; }
    .hrp-pill { padding: 12px 16px; font-size: 11px; }
    .hrp-live-badge { font-size: 11px; padding: 7px 12px; }
  }
</style>


{%- assign hide_until_cta = section.settings.hide_until_cta -%}

<style>
  /* Hidden until the "Sorbetto Collection" CTA card is clicked */
  .hro-gated { display: none; }
</style>

<!-- ════════════════════════════════════════════════════════════
     SECTION WRAPPER (wraps master case hero + product sections)
════════════════════════════════════════════════════════════ -->
<section id="hro-combined-{{ section.id }}"{% if hide_until_cta %} class="hro-gated"{% endif %}>

  <!-- ════════════════════════════════
       PART 1 — SORBETTO MASTER CASE HERO CARD
  ════════════════════════════════ -->

  {%- comment -%} Variant ids / prices: product picker wins, plain text is the fallback. {%- endcomment -%}
  {%- assign mixed_vid = section.settings.mixed_variant_id -%}
  {%- assign mixed_price = section.settings.price_fallback -%}
  {%- if section.settings.mixed_product != blank -%}
    {%- assign mixed_vid = section.settings.mixed_product.selected_or_first_available_variant.id -%}
    {%- assign mixed_price = section.settings.mixed_product.price | money -%}
  {%- endif -%}

  {%- assign strawberry_vid = section.settings.strawberry_variant_id -%}
  {%- assign strawberry_price = section.settings.strawberry_price -%}
  {%- if section.settings.strawberry_product != blank -%}
    {%- assign strawberry_vid = section.settings.strawberry_product.selected_or_first_available_variant.id -%}
    {%- assign strawberry_price = section.settings.strawberry_product.price | money -%}
  {%- endif -%}

  {%- assign banana_vid = section.settings.banana_variant_id -%}
  {%- assign banana_price = section.settings.banana_price -%}
  {%- if section.settings.banana_product != blank -%}
    {%- assign banana_vid = section.settings.banana_product.selected_or_first_available_variant.id -%}
    {%- assign banana_price = section.settings.banana_product.price | money -%}
  {%- endif -%}

  {%- assign peaches_vid = section.settings.peaches_variant_id -%}
  {%- assign peaches_price = section.settings.peaches_price -%}
  {%- if section.settings.peaches_product != blank -%}
    {%- assign peaches_vid = section.settings.peaches_product.selected_or_first_available_variant.id -%}
    {%- assign peaches_price = section.settings.peaches_product.price | money -%}
  {%- endif -%}

  {%- assign frootie_vid = section.settings.frootie_variant_id -%}
  {%- assign frootie_price = section.settings.frootie_price -%}
  {%- if section.settings.frootie_product != blank -%}
    {%- assign frootie_vid = section.settings.frootie_product.selected_or_first_available_variant.id -%}
    {%- assign frootie_price = section.settings.frootie_product.price | money -%}
  {%- endif -%}

  {%- comment -%} Product sections below reuse the variant ids resolved above; their own text field wins when filled. {%- endcomment -%}
  {%- assign s1_vid = strawberry_vid -%}
  {%- if section.settings.s1_variant_id != blank -%}{%- assign s1_vid = section.settings.s1_variant_id -%}{%- endif -%}

  {%- assign s2_vid = banana_vid -%}
  {%- if section.settings.s2_variant_id != blank -%}{%- assign s2_vid = section.settings.s2_variant_id -%}{%- endif -%}

  {%- assign s3_vid = peaches_vid -%}
  {%- if section.settings.s3_variant_id != blank -%}{%- assign s3_vid = section.settings.s3_variant_id -%}{%- endif -%}

  {%- assign s4_vid = frootie_vid -%}
  {%- if section.settings.s4_variant_id != blank -%}{%- assign s4_vid = section.settings.s4_variant_id -%}{%- endif -%}

  <div id="sorbetto" style="background: {{ section.settings.bg_color | default: '#f7ece2' }}; padding: 40px 24px 32px; scroll-margin-top: 120px;">

    <div class="hrp-shell">
      <div class="hrp-grid">

        <!-- LEFT -->
        <div class="hrp-left">

          <h1 class="hrp-title">
            <span class="hrp-title__top">{{ section.settings.title_top | default: 'Sorbetto' }}</span>
            <span class="hrp-title__gradient">{{ section.settings.title_gradient | default: 'Master Case' }}</span>
          </h1>

          <p class="hrp-flavor-sub" id="hrp-sub-{{ section.id }}">
            {{ section.settings.flavor_line | default: 'Strawberry • Banana Lemon Headz • Peaches & Cream • Frootie Scoops' }}
          </p>

          <div class="hrp-price" id="hrp-price-{{ section.id }}">
            {{ mixed_price }}
          </div>

          <p class="hrp-desc" id="hrp-desc-{{ section.id }}">
            {{ section.settings.description }}
          </p>

          <p class="hrp-choose-label">{{ section.settings.choose_label | default: 'Choose Your Case' }}</p>

          <div class="hrp-options">

            <button type="button" class="hrp-opt active" data-hrp-opt
              data-variant="{{ mixed_vid }}"
              data-price="{{ mixed_price }}"
              data-sub="{{ section.settings.flavor_line | default: 'Strawberry • Banana Lemon Headz • Peaches & Cream • Frootie Scoops' }}"
              data-desc="{{ section.settings.description | escape }}"
              data-label="Mixed Master Case Selected"
              data-pill="🍨 Sorbetto Collection"
              data-pill2="⬡ 4 Flavor Master Case"
              data-acc-desc="{{ section.settings.mixed_acc_desc | escape }}"
              data-acc-flavor="{{ section.settings.mixed_acc_flavor | escape }}"
              data-acc-specs="{{ section.settings.mixed_acc_specs | escape }}"
              data-acc-highlight="{{ section.settings.mixed_acc_highlight | escape }}"
              data-image="{{ img_case_mixed }}"
              data-mode="mixed"
              data-rosin-img="{{ img_rosin }}"
              data-lid-img="{{ img_lid }}">
              Mixed Master Case
            </button>

            <button type="button" class="hrp-opt" data-hrp-opt
              data-variant="{{ strawberry_vid }}"
              data-price="{{ strawberry_price }}"
              data-sub="{{ section.settings.s1_flavors | default: 'Sweet • Berry • Creamy' }}"
              data-desc="{{ section.settings.strawberry_desc | default: section.settings.description | escape }}"
              data-label="{{ section.settings.s1_name | default: 'Strawberry' }} Selected"
              data-pill="🍓 {{ section.settings.s1_name | default: 'Strawberry' }}"
              data-pill2="⬡ Single Flavor"
              data-acc-desc="{{ section.settings.strawberry_acc_desc | escape }}"
              data-acc-flavor="{{ section.settings.strawberry_acc_flavor | escape }}"
              data-acc-specs="{{ section.settings.strawberry_acc_specs | escape }}"
              data-acc-highlight="{{ section.settings.strawberry_acc_highlight | escape }}"
              data-image="{{ img_jar_strawberry }}"
              data-mode="single"
              data-rosin-img="{{ img_rosin }}"
              data-lid-img="{{ img_lid_strawberry }}">
              {{ section.settings.s1_name | default: 'Strawberry' }}
            </button>

            <button type="button" class="hrp-opt" data-hrp-opt
              data-variant="{{ banana_vid }}"
              data-price="{{ banana_price }}"
              data-sub="{{ section.settings.s2_flavors | default: 'Citrus • Tropical • Bright' }}"
              data-desc="{{ section.settings.banana_desc | default: section.settings.description | escape }}"
              data-label="{{ section.settings.s2_name | default: 'Banana Lemon Headz' }} Selected"
              data-pill="🍌 {{ section.settings.s2_name | default: 'Banana Lemon Headz' }}"
              data-pill2="⬡ Single Flavor"
              data-acc-desc="{{ section.settings.banana_acc_desc | escape }}"
              data-acc-flavor="{{ section.settings.banana_acc_flavor | escape }}"
              data-acc-specs="{{ section.settings.banana_acc_specs | escape }}"
              data-acc-highlight="{{ section.settings.banana_acc_highlight | escape }}"
              data-image="{{ img_jar_banana }}"
              data-mode="single"
              data-rosin-img="{{ img_rosin }}"
              data-lid-img="{{ img_lid_banana }}">
              {{ section.settings.s2_name | default: 'Banana Lemon Headz' }}
            </button>

            <button type="button" class="hrp-opt" data-hrp-opt
              data-variant="{{ peaches_vid }}"
              data-price="{{ peaches_price }}"
              data-sub="{{ section.settings.s3_flavors | default: 'Peach • Velvety • Sweet' }}"
              data-desc="{{ section.settings.peaches_desc | default: section.settings.description | escape }}"
              data-label="{{ section.settings.s3_name | default: 'Peaches & Cream' }} Selected"
              data-pill="🍑 {{ section.settings.s3_name | default: 'Peaches & Cream' }}"
              data-pill2="⬡ Single Flavor"
              data-acc-desc="{{ section.settings.peaches_acc_desc | escape }}"
              data-acc-flavor="{{ section.settings.peaches_acc_flavor | escape }}"
              data-acc-specs="{{ section.settings.peaches_acc_specs | escape }}"
              data-acc-highlight="{{ section.settings.peaches_acc_highlight | escape }}"
              data-image="{{ img_jar_peaches }}"
              data-mode="single"
              data-rosin-img="{{ img_rosin }}"
              data-lid-img="{{ img_lid_peaches }}">
              {{ section.settings.s3_name | default: 'Peaches & Cream' }}
            </button>

            <button type="button" class="hrp-opt" data-hrp-opt
              data-variant="{{ frootie_vid }}"
              data-price="{{ frootie_price }}"
              data-sub="{{ section.settings.s4_flavors | default: 'Fruity • Sweet • Creamy' }}"
              data-desc="{{ section.settings.frootie_desc | default: section.settings.description | escape }}"
              data-label="{{ section.settings.s4_name | default: 'Frootie Scoops' }} Selected"
              data-pill="🍨 {{ section.settings.s4_name | default: 'Frootie Scoops' }}"
              data-pill2="⬡ Single Flavor"
              data-acc-desc="{{ section.settings.frootie_acc_desc | escape }}"
              data-acc-flavor="{{ section.settings.frootie_acc_flavor | escape }}"
              data-acc-specs="{{ section.settings.frootie_acc_specs | escape }}"
              data-acc-highlight="{{ section.settings.frootie_acc_highlight | escape }}"
              data-image="{{ img_jar_frootie }}"
              data-mode="single"
              data-rosin-img="{{ img_rosin }}"
              data-lid-img="{{ img_lid_frootie }}">
              {{ section.settings.s4_name | default: 'Frootie Scoops' }}
            </button>

          </div>

          {%- comment -%}
            ── Mixed case flavor picker ──
            Only shown for the Mixed Master Case. Four steppers sharing one cap,
            so a shopper can take one of each, doubles, or four of a single
            flavor. Each flavor's count rides along as a line item property; the
            hidden inputs live inside the form so FormData picks them up, and JS
            disables the ones at 0 so unchosen flavors never reach the order.
          {%- endcomment -%}
          {%- assign mix_max = section.settings.mix_max | default: 4 -%}
          {%- assign s1 = section.settings.s1_name | default: 'Strawberry' -%}
          {%- assign s2 = section.settings.s2_name | default: 'Banana Lemon Headz' -%}
          {%- assign s3 = section.settings.s3_name | default: 'Peaches & Cream' -%}
          {%- assign s4 = section.settings.s4_name | default: 'Frootie Scoops' -%}

          <div class="hrp-mix" id="hrp-mix-{{ section.id }}" data-hrp-mix data-max="{{ mix_max }}">
            <p class="hrp-mix__label">
              <span>{{ section.settings.mix_label | default: 'Choose your 4 jars' }}</span>
              <span class="hrp-mix__meter" data-hrp-mix-meter>{{ mix_max }} of {{ mix_max }} selected</span>
            </p>

            {%- assign mix_flavors = s1 | append: '||' | append: s2 | append: '||' | append: s3 | append: '||' | append: s4 | split: '||' -%}
            {%- for flavor in mix_flavors -%}
              <div class="hrp-mix__row">
                <span class="hrp-mix__name">{{ flavor }}</span>
                <div class="hrp-mix__stepper">
                  <button type="button" class="hrp-mix__btn" data-hrp-mix-step="-1" data-hrp-mix-index="{{ forloop.index0 }}" aria-label="Remove one {{ flavor | escape }}">&minus;</button>
                  <span class="hrp-mix__qty" data-hrp-mix-qty="{{ forloop.index0 }}" aria-live="polite">1</span>
                  <button type="button" class="hrp-mix__btn" data-hrp-mix-step="1" data-hrp-mix-index="{{ forloop.index0 }}" aria-label="Add one {{ flavor | escape }}">+</button>
                </div>
              </div>
            {%- endfor -%}

            <p class="hrp-mix__hint" data-hrp-mix-hint></p>
          </div>

          <div class="hrp-actions">
            <form method="post" action="/cart/add" data-hrp-form>
              <input type="hidden" name="quantity" value="1">
              <input type="hidden" name="id" id="hrp-vid-{{ section.id }}" value="{{ mixed_vid }}">
              {%- for flavor in mix_flavors -%}
                <input type="hidden" name="properties[{{ flavor | escape }}]" data-hrp-mix-prop="{{ forloop.index0 }}" value="">
              {%- endfor -%}
              <button type="submit" class="hrp-atc">
                <span class="hrp-atc__check">✓</span> Add to cart
              </button>
            </form>
            <button type="button" class="hrp-wish hro-wish-btn" id="hrp-wish-{{ section.id }}" aria-label="Add to wishlist"
              data-variant-id="{{ mixed_vid }}"
              data-product-name="Mixed Master Case"
              data-product-price="{{ mixed_price }}"
              data-product-image="{{ img_case_mixed }}"
              data-product-emoji="🍨"
              onclick="HroWish.toggle(this)">
              ♡
            </button>
          </div>

          <!-- Mini rosin card -->
          <div class="hrp-mini-card">
            <img src="{{ img_rosin }}"
                 alt="{{ section.settings.feature_title | default: 'Solventless Rosin' }}" class="hrp-mini-card__img"
                 id="hrp-rosin-mini-{{ section.id }}">
            <div class="hrp-mini-card__text">
              <strong>{{ section.settings.feature_title | default: 'Solventless Rosin' }}</strong>
              <b>{{ section.settings.feature_sub | default: 'Cold Cure Live Rosin' }}</b>
              <small>{{ section.settings.feature_note | default: '2G Jar • 90–120µ • Small Batch' }}</small>
            </div>
          </div>


        </div><!-- /.hrp-left -->


        <!-- CENTER — HERO CARD -->
        <div class="hrp-center">
          <div class="hrp-hero-card">

            <div class="hrp-hero-top">
              <div class="hrp-selected-pill">
                <span class="hrp-selected-pill__check" aria-hidden="true">✓</span>
                <span id="hrp-label-{{ section.id }}">Mixed Master Case Selected</span>
              </div>
            </div>

            <div class="hrp-live-badge" id="hrpCaseLiveBadge">
              <span class="hrp-live-dot"></span>
              <span id="hrpCaseLiveCount">0</span> viewing now
            </div>

            <div class="hrp-jars" id="hrp-jars-{{ section.id }}">
              <img src="{{ img_case_mixed }}"
                   alt="{{ section.settings.title_top | default: 'Sorbetto' }} {{ section.settings.title_gradient | default: 'Master Case' }}"
                   class="hrp-jar hrp-jar--single" loading="lazy">
            </div>

            <div class="hrp-feat-card">
              <img src="{{ img_rosin }}"
                   alt="{{ section.settings.feature_title | default: 'Solventless Rosin' }}" class="hrp-feat-card__img"
                   id="hrp-rosin-feat-{{ section.id }}">
              <div class="hrp-feat-card__text">
                <strong>{{ section.settings.feature_title | default: 'Solventless Rosin' }}</strong>
                <b>{{ section.settings.feature_sub | default: 'Cold Cure Live Rosin' }}</b>
                <small>{{ section.settings.feature_note | default: '2G Jar • 90–120µ • Small Batch' }}</small>
              </div>
              <div class="hrp-feat-card__divider" aria-hidden="true"></div>
              <div class="hrp-feat-card__bucket" aria-hidden="true">
                <img src="{{ img_lid }}"
                     alt="" class="hrp-feat-card__bucket-img"
                     id="hrp-lid-icon-{{ section.id }}">
              </div>
            </div>

            <div class="hrp-bottom-pills">
              <div class="hrp-pill" id="hrp-pill1-{{ section.id }}">🍨 Sorbetto Collection</div>
              <div class="hrp-pill" id="hrp-pill2-{{ section.id }}">⬡ 4 Flavor Master Case</div>
            </div>

          </div>
        </div><!-- /.hrp-center -->


        <!-- RIGHT — ACCORDIONS -->
        <div class="hrp-right">

          <div class="hrp-acc">
            <button type="button" class="hrp-acc__btn" data-hrp-acc>
              Description <svg class="hrp-acc__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="hrp-acc__panel">
              <p id="hrp-acc-desc-{{ section.id }}">{{ section.settings.mixed_acc_desc | default: section.settings.description }}</p>
            </div>
          </div>

          <div class="hrp-acc">
            <button type="button" class="hrp-acc__btn" data-hrp-acc>
              Flavor Notes <svg class="hrp-acc__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="hrp-acc__panel">
              <p id="hrp-acc-flavor-{{ section.id }}">{{ section.settings.flavor_notes }}</p>
            </div>
          </div>

          <div class="hrp-acc hrp-acc--open">
            <button type="button" class="hrp-acc__btn" data-hrp-acc>
              Product Specs <svg class="hrp-acc__icon hrp-acc__icon--open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="hrp-acc__panel" id="hrp-acc-specs-panel-{{ section.id }}">
              <div id="hrp-acc-specs-{{ section.id }}" class="hrp-acc__panel-content">
                {{ section.settings.mixed_acc_specs }}
              </div>
              <p class="hrp-acc__highlight" id="hrp-acc-highlight-{{ section.id }}">
                {{ section.settings.mixed_acc_highlight | default: '🍨 All Four Sorbetto Flavors Inside' }}
              </p>
            </div>
          </div>

          <div class="hrp-acc">
            <button type="button" class="hrp-acc__btn" data-hrp-acc>
              Collection <svg class="hrp-acc__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="hrp-acc__panel">
              <p>{{ section.settings.collection_note | default: 'Part of the Sundaze Sorbetto hash rosin collection.' }}</p>
            </div>
          </div>

        </div><!-- /.hrp-right -->


      </div><!-- /.hrp-grid -->
    </div><!-- /.hrp-shell -->

  </div><!-- /master case wrapper -->


  <!-- ════════════════════════════════
       PART 2 — INDIVIDUAL HASH ROSIN PRODUCTS
  ════════════════════════════════ -->

  <style>
    #hro-combined-{{ section.id }} .hro-page {
      min-height: unset;
      width: 100%;
      background: linear-gradient(135deg, #f9f7f4 0%, #f5f2ee 60%, #fef0f5 100%);
      font-family: 'DM Sans', sans-serif;
      position: relative;
      overflow-x: hidden;
    }

    #hro-combined-{{ section.id }} .hro-glow {
      pointer-events: none;
      position: absolute;
      right: 0; top: 0;
      height: 500px; width: 500px;
      opacity: 0.4;
      background: radial-gradient(circle at 80% 20%, #fce4ec 0%, #fff9c4 30%, #e0f7fa 60%, transparent 80%);
      z-index: 0;
    }

    /* No top padding: the master case wrapper above already ends with the
       same 32px the flavor cards keep between themselves, so one gap
       rather than two runs the whole stack. */
    #hro-combined-{{ section.id }} .hro-container {
      position: relative;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 16px 24px;
      z-index: 1;
    }
    @media (min-width: 640px) {
      #hro-combined-{{ section.id }} .hro-container { padding: 0 24px 40px; }
    }

    #hro-combined-{{ section.id }} .hro-card {
      position: relative; overflow: hidden; border-radius: 24px;
      background: #ffffff; box-shadow: 0 25px 50px rgba(0,0,0,0.05);
      opacity: 0; transform: translateY(16px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    #hro-combined-{{ section.id }} .hro-card.visible { opacity: 1; transform: translateY(0); }

    #hro-combined-{{ section.id }} .hro-grid {
      display: grid; grid-template-columns: 1fr; gap: 0;
    }
    @media (min-width: 1024px) {
      #hro-combined-{{ section.id }} .hro-grid { grid-template-columns: 1fr 1.2fr 1fr; }
    }

    #hro-combined-{{ section.id }} .hro-left {
      display: flex; flex-direction: column; justify-content: center;
      padding: 32px 24px; order: 2;
      opacity: 0; transform: translateX(-20px);
      transition: opacity 0.6s ease 0.2s, transform 0.6s ease 0.2s;
    }
    #hro-combined-{{ section.id }} .hro-left.visible { opacity: 1; transform: translateX(0); }
    @media (min-width: 640px) { #hro-combined-{{ section.id }} .hro-left { padding: 32px 40px; } }
    @media (min-width: 1024px) { #hro-combined-{{ section.id }} .hro-left { padding: 64px 40px; order: 1; } }

    #hro-combined-{{ section.id }} .hro-title {
      font-family: 'Playfair Display', serif;
      font-size: 40px;
      font-weight: 900;
      line-height: 0.95;
      letter-spacing: -0.02em;
      color: #1a1a1a;
      margin: 0 0 8px;
      /* base.css gives every h1–h5 word-break: break-word, which splits a long
         flavor name mid-word ("Strawberrie / s") once the desktop grid narrows
         this column. Wrap between words only. */
      word-break: normal;
      overflow-wrap: normal;
      hyphens: none;
    }
    @media (min-width: 640px)  { #hro-combined-{{ section.id }} .hro-title { font-size: 48px; } }
