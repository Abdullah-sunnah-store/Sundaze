    /* ══════════════════════════════════════════════════════════════════
       4. WHAT SHOPPERS ACTUALLY MEAN

       Nobody types "products with the energized effect metafield". They type
       "something for the gym" or "what'll wake me up". Each intent below maps
       that language onto the values you set in Shopify admin.

       `want`  — effects that satisfy the ask outright (scored highest)
       `near`  — effects that are adjacent, used only when nothing matches
                 `want`, so SCOOP can offer a closest-thing instead of a
                 dead end. It always says which one it is doing.
    ══════════════════════════════════════════════════════════════════ */
    var EFFECT_INTENTS = [
      {
        id: 'energy',
        asked: 'energizing',
        match: /\b(energy|energetic|energi[sz]\w*|awake|wake me|wake up|alert|alertness|productive|productivity|day ?time|morning|pick ?me ?up|motivat\w*|get going|get moving|active|workout|work out|gym|hike|hiking|running|stimulat\w*|lively|perk\w* up|before work)\b/i,
        want: ['energized', 'energizing', 'energetic', 'uplifted', 'uplifting', 'motivated', 'stimulating'],
        near: ['focused', 'creative', 'happy', 'euphoric'],
        strain: /sativa/i,
        time: /day|morning|anytime/i
      },
      {
        id: 'relax',
        asked: 'relaxing',
        match: /\b(relax\w*|chill|chilling|calm\w*|unwind|wind ?down|winding down|decompress|de-?stress|stress|mellow|laid ?back|take the edge off|after work|couch|lazy|easy going|peaceful|soothing)\b/i,
        want: ['relaxed', 'relaxing', 'calm', 'calming', 'mellow', 'blissful', 'peaceful'],
        near: ['sleepy', 'happy', 'balanced'],
        strain: /indica/i,
        time: /evening|night|anytime/i
      },
      {
        id: 'sleep',
        asked: 'sleepy or wind-down',
        match: /\b(sleep|sleepy|asleep|bed ?time|before bed|night ?time|at night|late night|knock me out|pass out|drowsy|doze|restful|rest|nightcap|end of the day)\b/i,
        want: ['sleepy', 'sedating', 'sedative', 'restful', 'drowsy'],
        near: ['relaxed', 'calm', 'mellow', 'blissful'],
        strain: /indica/i,
        time: /night|evening/i
      },
      {
        id: 'focus',
        asked: 'focused',
        match: /\b(focus\w*|concentrat\w*|study|studying|clear ?head\w*|sharp|dial\w* in|work on|getting things done|task|deep work)\b/i,
        want: ['focused', 'focus', 'clear-headed', 'clear headed', 'motivated'],
        near: ['energized', 'uplifted', 'creative', 'balanced'],
        strain: /sativa|hybrid/i,
        time: /day|anytime/i
      },
      {
        id: 'creative',
        asked: 'creative',
        match: /\b(creativ\w*|inspir\w*|art|artistic|music|writing|write|paint|ideas|brainstorm|studio)\b/i,
        want: ['creative', 'creativity', 'inspired', 'inspiring'],
        near: ['euphoric', 'uplifted', 'happy', 'energized'],
        strain: /sativa|hybrid/i,
        time: /day|anytime/i
      },
      {
        id: 'mood',
        asked: 'mood-lifting',
        match: /\b(happy|happier|mood|uplift\w*|euphor\w*|giggl\w*|laugh\w*|good vibes|feel good|cheer\w*|bliss\w*|joy\w*)\b/i,
        want: ['happy', 'euphoric', 'uplifted', 'blissful', 'giggly'],
        near: ['relaxed', 'creative', 'social'],
        strain: null,
        time: null
      },
      {
        id: 'social',
        asked: 'social',
        match: /\b(social|party|parties|friends|hang ?out|hanging out|gathering|talkative|chatty|group|kickback|get ?together|with people)\b/i,
        want: ['social', 'talkative', 'giggly', 'happy'],
        near: ['euphoric', 'uplifted', 'energized'],
        strain: null,
        time: null
      }
    ];

    /* Product-shaped asks that are not about effects. */
    var ASK = {
      recommend:  /\b(recommend\w*|suggest\w*|what should i (get|buy|try|order|start with)|which (one|should|product)|help me (pick|choose|decide)|best (one|seller|product)|most popular|new here|first time (buyer|ordering)|where do i start|what do you (have|sell|carry|offer)|what are my options|show me)\b/i,
      strongest:  /\b(strong\w*|potent|potency|hardest hitting|heaviest|highest thca|most thca|knock\w* out|highest percentage)\b/i,
      mildest:    /\b(mild\w*|weak\w*|lightest|low tolerance|lightweight|beginner|beginners|new to this|first time (smoking|trying)|not too strong|gentle|easy)\b/i,
      cheapest:   /\b(cheap\w*|affordable|budget|least expensive|lowest price|best value|deal|under \$?\d+|entry level)\b/i,
      priciest:   /\b(most expensive|priciest|top shelf|highest end|splurge|premium option|best you (have|got))\b/i,
      price:      /\b(price|prices|pricing|cost|costs|how much)\b/i,
      stock:      /\b(in stock|out of stock|sold out|available|availability|restock|back in stock)\b/i,
      flavor:     /\b(flavou?r\w*|taste\w*|tasting|profile|terpene\w*|smell\w*|aroma|nose|notes|sweet|fruity|citrus|berry|strawberry|banana|lemon|peach|vanilla|chocolate|hazelnut|nutty|creamy|cream|dessert|candy|maple|pancake|cereal|gassy|earthy|nugtella|shortcake|cake|buttery|doughy|tropical|minty|cool)\b/i,
      compare:    /\b(differ\w*|compare|comparison|versus|\bvs\b|better than|which is better|instead of)\b/i,
      gift:       /\b(gift|present|for my (friend|partner|wife|husband|brother|sister)|birthday|holiday|christmas)\b/i
    };

    var CATEGORY = [
      { match: /\b(rosin|jar|jars|concentrate|dab|dabs|solventless|sorbetto)\b/i, test: /rosin/i, label: 'hash rosin', url: L.rosin },
      { match: /\b(hash ?hole|donut+e?|pre-?roll|joint|preroll)\b/i,               test: /hash hole/i, label: 'hash holes', url: L.holes },
      { match: /\b(flower|bud|buds|eighth|3\.5|nug|nugs|strain|strains)\b/i,       test: /flower/i,   label: '3.5G flower', url: L.flower },
      { match: /\b(bucket|buckets|bulk|master case|case)\b/i,                      test: /bucket|case/i, label: 'buckets and cases', url: L.buckets }
    ];

    /* ══════════════════════════════════════════════════════════════════
       5. THE PRODUCT ENGINE
       Ranks the live catalogue against whatever the shopper asked for and
       reports honestly when the catalogue has no good answer.
    ══════════════════════════════════════════════════════════════════ */

    function cap(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : s; }

    function inCategory(p, test) {
      var hay = (p.type || '') + ' ' + (p.tags || []).join(' ') + ' ' + (p.collections || []).join(' ') + ' ' + (p.title || '');
      return test.test(hay);
    }

    function detectCategory(q) {
      for (var i = 0; i < CATEGORY.length; i++) {
        if (CATEGORY[i].match.test(q)) return CATEGORY[i];
      }
      return null;
    }

    /* Score every tagged product against one effect intent. Returns matches
       for `want`, and separately the best `near` fallbacks, so the caller can
       tell the shopper which of the two it is handing them. */
    function matchEffect(intent, category) {
      var pool = taggedProducts();
      if (category) {
        var narrowed = pool.filter(function (p) { return inCategory(p, category.test); });
        if (narrowed.length) pool = narrowed;
      }

      var direct = [], adjacent = [];

      pool.forEach(function (p) {
        var eff    = effectsOf(p);
        var best   = listOf(p.best_for).join(' ');
        var strain = textOf(p.strain_type);
        var time   = textOf(p.time_of_day);

        var score = 0, hits = [];

        intent.want.forEach(function (w) {
          if (eff.indexOf(w) !== -1) { score += 3; hits.push(cap(w)); }
          else if (best.indexOf(w) !== -1) { score += 1.5; }
        });
        if (intent.strain && strain && intent.strain.test(strain)) score += 2;
        if (intent.time && time && intent.time.test(time)) score += 1.5;

        if (score > 0) { direct.push({ p: p, score: score, hits: hits }); return; }

        var nearScore = 0, nearHits = [];
        intent.near.forEach(function (w) {
          if (eff.indexOf(w) !== -1) { nearScore += 1; nearHits.push(cap(w)); }
        });
        if (nearScore > 0) adjacent.push({ p: p, score: nearScore, hits: nearHits });
      });

      /* Score decides. Stock only breaks a tie — a sold-out product is
         still the honest answer when it is the better match. */
      var bySort = function (x, y) {
        if (y.score !== x.score) return y.score - x.score;
        return (x.p.available === false ? 1 : 0) - (y.p.available === false ? 1 : 0);
      };
      direct.sort(bySort);
      adjacent.sort(bySort);
      return { direct: direct, adjacent: adjacent, poolSize: pool.length };
    }

    /* Flavour is descriptive, not a health claim, so this one is allowed to
       read the product copy as well as the flavour metafield. */
    function matchFlavor(q, category) {
      var tokens = tokenize(q).filter(function (t) { return !ASK.flavor.test(t) || /^(sweet|fruity|citrus|berry|strawberry|banana|lemon|peach|vanilla|chocolate|hazelnut|nutty|creamy|cream|dessert|candy|maple|pancake|cereal|gassy|earthy|nugtella|shortcake|cake|buttery|doughy|tropical|minty|cool)$/.test(t); });
      var pool = SITE.products;
      if (category) {
        var narrowed = pool.filter(function (p) { return inCategory(p, category.test); });
        if (narrowed.length) pool = narrowed;
      }

      var scored = pool.map(function (p) {
        var notes = listOf(p.flavor_notes).join(' ');
        var body  = String(p.description || '').toLowerCase();
        var title = String(p.title || '').toLowerCase();
        var score = 0, hits = [];
        tokens.forEach(function (t) {
          if (t.length < 3) return;
          if (notes.indexOf(t) !== -1) { score += 3; hits.push(cap(t)); }
          else if (title.indexOf(t) !== -1) { score += 2.5; }
          else if (body.indexOf(t) !== -1) { score += 1; hits.push(cap(t)); }
        });
        return { p: p, score: score, hits: hits.slice(0, 3) };
      }).filter(function (r) { return r.score > 0; });

      scored.sort(function (x, y) { return y.score - x.score; });
      return scored;
    }

    /* Ranking by potency means comparing two different kinds of published
       data: a THCa percentage where a product has one, and a written potency
       level where it doesn't. A percentage and a word are not comparable
       numbers, so both are folded onto the same 1-4 band first. The band is
       only ever a sort key — cards still show whichever value the product
       actually publishes, and no percentage is invented for anything. */
    var LEVEL_BAND = {
      'mild': 1, 'gentle': 1, 'light': 1,
      'moderate': 2, 'medium': 2, 'balanced': 2,
      'strong': 3, 'potent': 3,
      'very strong': 4, 'extra strong': 4, 'heavy': 4
    };

    function potencyBand(p) {
      var pct = thcaOf(p);
      if (pct != null) {
        var n = Number(pct);
        if (!isNaN(n)) return n < 20 ? 1 : n < 28 ? 2 : n < 34 ? 3 : 4;
      }
      return LEVEL_BAND[textOf(p.potency_level).toLowerCase()] || 0;
    }

    function byPotency(desc, category) {
      var pool = SITE.products.filter(function (p) { return potencyBand(p) > 0; });
      if (category) {
        var narrowed = pool.filter(function (p) { return inCategory(p, category.test); });
        if (narrowed.length) pool = narrowed;
      }
      return pool.slice().sort(function (x, y) {
        var band = desc ? potencyBand(y) - potencyBand(x) : potencyBand(x) - potencyBand(y);
        if (band) return band;

        var xn = thcaOf(x) != null ? Number(thcaOf(x)) : null;
        var yn = thcaOf(y) != null ? Number(thcaOf(y)) : null;
        if (xn != null && yn != null) return desc ? yn - xn : xn - yn;
        /* Within a band, a product publishing a real number is the more
           useful answer than one carrying only a label. */
        if (xn != null) return -1;
        if (yn != null) return 1;
        return (x.price_cents || 0) - (y.price_cents || 0);
      });
    }

    function byPrice(desc, category) {
      var pool = SITE.products.filter(function (p) { return typeof p.price_cents === 'number' && p.price_cents > 0; });
      if (category) {
        var narrowed = pool.filter(function (p) { return inCategory(p, category.test); });
        if (narrowed.length) pool = narrowed;
      }
      return pool.slice().sort(function (x, y) {
        return desc ? y.price_cents - x.price_cents : x.price_cents - y.price_cents;
      });
    }

    /* ══════════════════════════════════════════════════════════════════
       6. TEXT RETRIEVAL
       Token overlap with a synonym map, scored across four kinds of source:
       the curated answers above, plus every product, page and guide pulled
       out of the site index. Field weights favour a title hit over a body
       hit, so "refund policy" lands on the policy page rather than on some
       product that happens to mention refunds.
    ══════════════════════════════════════════════════════════════════ */
    var STOP = {
      'a':1,'an':1,'the':1,'is':1,'are':1,'am':1,'be':1,'do':1,'does':1,'did':1,'to':1,'of':1,
      'in':1,'on':1,'for':1,'it':1,'i':1,'you':1,'your':1,'my':1,'me':1,'we':1,'can':1,'and':1,
      'or':1,'that':1,'this':1,'have':1,'has':1,'with':1,'what':1,'whats':1,'how':1,'if':1,'so':1,
      'about':1,'get':1,'any':1,'there':1,'from':1,'at':1,'as':1,'will':1,'would':1,'please':1,
      'im':1,'ive':1,'want':1,'need':1,'looking':1,'something':1,'give':1,'make':1,'feel':1,
      'anything':1,'everything':1,'got':1,'tell':1,'show':1,'like':1,'some':1,'one':1,'ones':1
    };

    var SYNONYMS = {
      'thc':'thca','delta':'d9','weed':'flower','bud':'flower','pot':'flower','nug':'flower',
      'preroll':'hash hole','prerolls':'hash hole','joint':'hash hole','joints':'hash hole','donutte':'hash hole',
      'ship':'shipping','ships':'shipping','shipped':'shipping','deliver':'shipping','delivery':'shipping',
      'cost':'price','pricing':'price','expensive':'price','cheap':'price',
      'lab':'coa','labs':'coa','testing':'coa','tested':'coa','certificate':'coa',
      'legality':'legal','lawful':'legal','allowed':'legal',
      'refunds':'refund','returns':'return','exchange':'refund','money':'refund',
      'buy':'shop','purchase':'shop','order':'order','ordering':'order',
      'human':'contact','agent':'contact','someone':'contact','rep':'contact','support':'contact',
      'concentrate':'rosin','dabs':'rosin','dab':'rosin','solventless':'rosin',
      'kid':'age','kids':'age','minor':'age','underage':'age','old':'age',
      'strain':'flower','strains':'flower','eighth':'flower'
    };

    function tokenize(text) {
      var raw = String(text || '')
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, ' ')
        .split(/\s+/);
      var out = [];
      for (var i = 0; i < raw.length; i++) {
        var t = raw[i];
        if (!t || t.length < 2 || STOP[t]) continue;
        out.push(t);
        if (SYNONYMS[t]) {
          var extra = SYNONYMS[t].split(' ');
          for (var j = 0; j < extra.length; j++) out.push(extra[j]);
        }
        /* crude singular so "states" matches "state" */
        if (t.length > 3 && t.charAt(t.length - 1) === 's') out.push(t.slice(0, -1));
      }
      return out;
    }

    var CORPUS = [];

    function corpusEntry(kind, title, keys, body, url, ref) {
      return {
        kind: kind,
        title: title,
        url: url || '',
        ref: ref || null,
        t_title: ' ' + tokenize(title).join(' ') + ' ',
        t_keys:  ' ' + tokenize(keys).join(' ') + ' ',
        t_body:  ' ' + tokenize(body).join(' ') + ' '
      };
    }

    function buildCorpus() {
      CORPUS = [];

      SCOOP_KB.forEach(function (entry) {
        CORPUS.push(corpusEntry('faq', entry.q, entry.k, entry.a.replace(/<[^>]+>/g, ' '), '', entry));
      });

      SITE.products.forEach(function (p) {
        var keys = [p.type, (p.tags || []).join(' '), (p.collections || []).join(' '),
                    listOf(p.flavor_notes).join(' '), listOf(p.effects).join(' '),
                    textOf(p.strain_type), textOf(p.time_of_day)].join(' ');
        CORPUS.push(corpusEntry('product', p.title, keys, p.description || '', p.url, p));
      });

      SITE.pages.forEach(function (pg) {
        CORPUS.push(corpusEntry('page', pg.title, pg.title, pg.content || '', pg.url, pg));
      });

      SITE.articles.forEach(function (ar) {
        CORPUS.push(corpusEntry('article', ar.title, ar.title, ar.content || '', ar.url, ar));
      });
    }

    function search(question) {
      var tokens = tokenize(question);
      if (!tokens.length) return [];
      var seen = {}, unique = [];
      tokens.forEach(function (t) { if (!seen[t]) { seen[t] = 1; unique.push(t); } });

      var scored = CORPUS.map(function (row) {
        var score = 0;
        for (var i = 0; i < unique.length; i++) {
          var needle = ' ' + unique[i] + ' ';
          if (row.t_title.indexOf(needle) !== -1) score += 2.2;
          else if (row.t_keys.indexOf(needle) !== -1) score += 2;
          else if (row.t_body.indexOf(needle) !== -1) score += 0.5;
        }
        /* Curated policy answers outrank a stray product mention of the same
           word — a shipping question should not land on a jar of rosin. */
        if (row.kind === 'faq') score *= 1.15;
        return { row: row, score: score / Math.sqrt(unique.length) };
      });

      scored.sort(function (x, y) { return y.score - x.score; });
      return scored;
    }

    var CONFIDENT = 1.35;

    /* Direct product lookup — "tell me about Frosty Shorty". Requires a solid
       chunk of the title to match so it doesn't fire on a single stray word. */
    function findProductByName(q) {
      var lower = ' ' + String(q).toLowerCase().replace(/[^a-z0-9\s]/g, ' ').replace(/\s+/g, ' ') + ' ';
      var best = null, bestScore = 0;
      SITE.products.forEach(function (p) {
        var words = String(p.title).toLowerCase().replace(/[^a-z0-9\s]/g, ' ').split(/\s+/)
          .filter(function (w) { return w.length > 2 && !/^(the|and|hash|g|3|5)$/.test(w); });
        if (!words.length) return;
        var hit = 0;
        words.forEach(function (w) { if (lower.indexOf(' ' + w + ' ') !== -1) hit++; });
        var ratio = hit / words.length;
        if (hit >= 2 && ratio > bestScore) { bestScore = ratio; best = p; }
      });
      return bestScore >= 0.5 ? best : null;
    }

    /* ══════════════════════════════════════════════════════════════════
       7. RENDERING
    ══════════════════════════════════════════════════════════════════ */
    function scrollDown() { log.scrollTop = log.scrollHeight; }

    function addMessage(html, who) {
      var el = document.createElement('div');
      el.className = 'scoop__msg scoop__msg--' + who;
      el.innerHTML = html;
      log.appendChild(el);
      scrollDown();
      return el;
    }

    function addTyping() {
      var el = document.createElement('div');
      el.className = 'scoop__msg scoop__msg--bot scoop__typing';
      el.innerHTML = '<span></span><span></span><span></span>';
      log.appendChild(el);
      scrollDown();
      return el;
    }

    function escapeHtml(text) {
      return String(text).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    /* A product card. `why` is the honest reason this one came back — either
       the effect values you set in admin, or the flavour notes that matched. */
    function productCard(p, why) {
      var img = p.image
        ? '<span class="scoop__card-img"><img src="' + escapeHtml(p.image) + '" alt="" loading="lazy" width="52" height="52"></span>'
        : '<span class="scoop__card-img scoop__card-img--empty" aria-hidden="true">🍨</span>';

      var meta = [];
      if (p.price) meta.push(escapeHtml(p.price));
      if (p.type)  meta.push(escapeHtml(p.type));
      var thca = thcaOf(p);
      if (thca != null) meta.push(escapeHtml(thca) + '% THCa');

      var reason = why ? '<span class="scoop__card-why">' + escapeHtml(why) + '</span>' : '';
      var soldOut = p.available === false ? '<span class="scoop__card-out">Sold out</span>' : '';

      return '<a class="scoop__card" href="' + escapeHtml(p.url) + '">' +
               img +
               '<span class="scoop__card-body">' +
                 '<span class="scoop__card-name">' + escapeHtml(p.title) + soldOut + '</span>' +
                 '<span class="scoop__card-meta">' + meta.join(' &middot; ') + '</span>' +
                 reason +
               '</span>' +
             '</a>';
    }

    function productCards(rows, whyFn) {
      if (!rows.length) return '';
      return '<span class="scoop__cards">' + rows.map(function (r) {
        var p = r.p || r;
        return productCard(p, whyFn ? whyFn(r) : '');
      }).join('') + '</span>';
    }

    /* The reason line under a card, built only from published values. */
    function effectWhy(row) {
      var p = row.p;
      var bits = [];
      if (row.hits && row.hits.length) bits = bits.concat(row.hits.slice(0, 3));
      else bits = bits.concat(effectsOf(p).slice(0, 3).map(cap));
      var t = textOf(p.time_of_day);
      if (t) bits.push(t);
      return bits.join(' · ');
    }

    function DEFAULT_CHIPS_FN() {
      var out = ['What would you recommend?'];
      if (taggedProducts().length) out.push('Something relaxing?');
      out.push('Which states do you not ship to?', 'Where are the lab results?', 'Leave a message');
      return out;
    }

    function setChips(list) {
      chips.innerHTML = '';
      (list || []).forEach(function (label) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'scoop__chip';
        b.textContent = label;
        b.addEventListener('click', function () { submit(label); });
        chips.appendChild(b);
      });
    }

    /* ══════════════════════════════════════════════════════════════════
       8. ANSWER BUILDERS
       Each returns { html, chips, lead } — `lead` asking for the handoff
       form to follow the message.
    ══════════════════════════════════════════════════════════════════ */

    var NO_EFFECT_DATA =
      '<p>I can talk flavour, format and price all day — but I can’t match products to how they feel yet, and I’m not going to guess at that one.</p>' +
      '<p>Have a look at the ' + a(L.flavors, 'flavors page') + ' to see the lineup, or leave your question below and someone on the team will give you a straight answer.</p>';

    function allSoldOut(rows) {
      if (!rows.length) return false;
      for (var i = 0; i < rows.length; i++) {
        if ((rows[i].p || rows[i]).available !== false) return false;
      }
      return true;
    }

    /* When every effect match is sold out, show what can actually be bought
       instead — by flavour and format only, since none of the in-stock
       products publish an effect. Better than a dead end, and it claims
       nothing that isn't on the page. */
    function inStockSuggestion() {
      var live = SITE.products.filter(function (p) { return p.available !== false; });
      if (!live.length) return '';
      live.sort(function (a1, b1) { return (a1.price_cents || 0) - (b1.price_cents || 0); });
      return '<p>What is on the shelf today:</p>' +
             productCards(live.slice(0, 3), function (r) {
               var p = r.p || r;
               return listOf(p.flavor_notes).slice(0, 3).map(cap).join(' · ');
             });
    }

    var SOLD_OUT_NOTE =
      '<p>One catch — everything above is sold out at the moment. Leave your ' +
      'details and the team will let you know the day it lands.</p>';

    function answerEffect(intent, category) {
      if (!taggedProducts().length) {
        return { html: NO_EFFECT_DATA, lead: true, chips: [] };
      }

      var m = matchEffect(intent, category);

      if (m.direct.length) {
        var top  = m.direct.slice(0, 3);
        var gone = allSoldOut(top);
        return {
          html: '<p>For something <strong>' + intent.asked + '</strong>, this is what fits from what we carry:</p>' +
                productCards(top, effectWhy) +
                EFFECT_DISCLAIMER +
                (gone ? SOLD_OUT_NOTE + inStockSuggestion() : ''),
          lead: gone,
          chips: gone ? [] : ['Where are the lab results?', 'What is in a hash hole?', 'Leave a message']
        };
      }

      if (m.adjacent.length) {
        var near = m.adjacent.slice(0, 2);
        return {
          html: '<p>Straight answer: nothing in the lineup right now is described as <strong>' + intent.asked + '</strong>, and I’d rather tell you that than talk you into something.</p>' +
                '<p>The closest we have:</p>' +
                productCards(near, effectWhy) +
                EFFECT_DISCLAIMER +
                (allSoldOut(near)
                  ? '<p>Both are sold out right now as well — leave your details and the team can tell you what’s coming and when.</p>' + inStockSuggestion()
                  : '<p>If that’s not the direction you wanted, leave your details and the team can tell you what’s coming.</p>'),
          lead: true,
          chips: []
        };
      }

      return {
        html: '<p>Nothing we carry is described as <strong>' + intent.asked + '</strong> — I’d be making it up if I said otherwise.</p>' +
              '<p>Leave your question below and the team will point you somewhere useful.</p>',
        lead: true,
        chips: []
      };
    }

    function answerProduct(p) {
      var bits = [];
      var desc = String(p.description || '').trim();
      if (desc) bits.push('<p>' + escapeHtml(desc) + '</p>');

      var facts = [];
      if (textOf(p.strain_type))   facts.push('<strong>Type:</strong> ' + escapeHtml(textOf(p.strain_type)));
      var thca = thcaOf(p);
      if (thca != null)            facts.push('<strong>THCa:</strong> ' + escapeHtml(thca) + '%');
      if (effectsOf(p).length)     facts.push('<strong>Reported effects:</strong> ' + effectsOf(p).map(cap).join(', '));
      if (textOf(p.time_of_day))   facts.push('<strong>Best for:</strong> ' + escapeHtml(textOf(p.time_of_day)));
      if (listOf(p.flavor_notes).length) facts.push('<strong>Flavour:</strong> ' + listOf(p.flavor_notes).map(cap).join(', '));
      if (facts.length) bits.push('<ul><li>' + facts.join('</li><li>') + '</li></ul>');

      if (p.available === false) bits.push('<p>It’s sold out at the moment — worth checking back.</p>');

      var html = '<p><strong>' + escapeHtml(p.title) + '</strong>' + (p.price ? ' — ' + escapeHtml(p.price) : '') + '</p>' +
                 bits.join('') +
                 productCards([p]);

      if (effectsOf(p).length) html += EFFECT_DISCLAIMER;

      return { html: html, chips: ['What would you recommend?', 'Where are the lab results?'] };
    }

    function answerList(intro, rows, whyFn, withDisclaimer) {
      return {
        html: '<p>' + intro + '</p>' + productCards(rows, whyFn) + (withDisclaimer ? EFFECT_DISCLAIMER : ''),
        chips: ['What would you recommend?', 'Where are the lab results?', 'Leave a message']
      };
    }

    function answerCatalogue(category) {
      if (category) {
        var inCat = SITE.products.filter(function (p) { return inCategory(p, category.test); });
        if (inCat.length) {
          return answerList('Here’s the ' + category.label + ' lineup:',
            inCat.slice(0, 5),
            function (r) { var p = r.p || r; return listOf(p.flavor_notes).slice(0, 3).map(cap).join(' · '); });
        }
      }

      if (!SITE.collections.length && !SITE.products.length) {
        return {
          html: '<p>Browse the full lineup here: ' + a(L.all, 'everything we make') + '.</p>',
          chips: []
        };
      }

      var lines = SITE.collections.slice(0, 6).map(function (c) {
        return '<li>' + a(c.url, escapeHtml(c.title)) + ' — ' + c.count + ' ' + (c.count === 1 ? 'product' : 'products') + '</li>';
      });

      return {
        html: '<p>Here’s what Sundaze makes right now:</p><ul>' + lines.join('') + '</ul>' +
              '<p>Or browse ' + a(L.all, 'everything') + '. Tell me what kind of session you’re after and I’ll narrow it down.</p>',
        chips: ['Something relaxing?', 'What’s your strongest?', 'What flavors do you have?']
      };
    }

    function answerRecommend(category) {
      var pool = SITE.products.filter(function (p) { return p.available !== false; });
      if (category) {
        var narrowed = pool.filter(function (p) { return inCategory(p, category.test); });
        if (narrowed.length) pool = narrowed;
      }
      if (!pool.length) return answerCatalogue(category);

      return {
        html: '<p>Depends what you’re after — but these are the ones I’d put in front of you first:</p>' +
              productCards(pool.slice(0, 3), function (r) {
                var p = r.p || r;
                var notes = listOf(p.flavor_notes).slice(0, 3).map(cap).join(' · ');
                return notes || String(p.type || '');
              }) +
              '<p>Tell me the vibe you want — relaxing, social, something for the evening — and I’ll get more specific.</p>',
        chips: ['Something relaxing?', 'What’s your strongest?', 'What’s the cheapest?']
      };
    }

    /* ══════════════════════════════════════════════════════════════════
       9. ROUTING — what kind of question is this?
    ══════════════════════════════════════════════════════════════════ */
    var DEFINITIONAL = /^\s*(?:what|what'?s|whats|how|tell me)\s+(?:is|are|do|does|much|many|big|long|the difference|in|inside|comes?|goes?|about)\b/i;

    /* "Is your flower indoor?" names a category too, but it wants a fact about
       how the thing is made, not a list of jars. Same for lab testing, micron
       and cold cure. These go to the curated answers instead. */
    var SPEC = /\b(indoor|outdoor|grown|lab ?tested|third[- ]party|solventless|micron|microns|90u|120u|small ?batch|fresh ?frozen|cold ?cure|hand ?rolled|glass tip|artificial|additives?|fillers?|cutting agents?)\b/i;

    function route(q) {
      var category = detectCategory(q);

      /* A named product beats everything else — if someone types a product
         name, that is what they want to hear about. */
      var named = findProductByName(q);
      if (named) return answerProduct(named);

      /* Effects — metafield-driven, never inferred from marketing copy. */
      for (var i = 0; i < EFFECT_INTENTS.length; i++) {
        if (EFFECT_INTENTS[i].match.test(q)) return answerEffect(EFFECT_INTENTS[i], category);
      }

      /* Mildest is tested first on purpose: "something not too strong" and
         "I'm new to this, nothing heavy" both contain the words the strongest
         branch looks for. A beginner asking for something gentle must never be
         handed the hardest-hitting jar on the shelf. */
      if (ASK.mildest.test(q)) {
        var mild = byPotency(false, category);
        if (mild.length) {
          return answerList('If you want to start easy, these sit at the lower end of what we carry:', mild.slice(0, 3), function (r) {
            var p = r.p || r;
            return (p.thca_percent != null ? p.thca_percent + '% THCa' : textOf(p.potency_level));
          }, true);
        }
      }

      if (ASK.strongest.test(q) && !ASK.mildest.test(q)) {
        var strong = byPotency(true, category);
        if (strong.length) {
          return answerList('Strongest we carry, by the numbers on the label:', strong.slice(0, 3), function (r) {
            var p = r.p || r;
            return (p.thca_percent != null ? p.thca_percent + '% THCa' : textOf(p.potency_level));
          }, true);
        }
      }

      if (ASK.cheapest.test(q)) {
        var cheap = byPrice(false, category);
        if (cheap.length) return answerList('Lowest-priced first:', cheap.slice(0, 3));
      }

      if (ASK.priciest.test(q) || ASK.gift.test(q)) {
        var lux = byPrice(true, category);
        if (lux.length) {
          return answerList(ASK.gift.test(q) ? 'These are the ones that give best as a gift:' : 'Top of the range:', lux.slice(0, 3));
        }
      }

      if (ASK.flavor.test(q)) {
        var flav = matchFlavor(q, category);
        /* A body-only hit scores 1 and normally isn't enough on its own. But
           when no product publishes flavour metafields, product copy is the
           only flavour source in the store — so the bar has to come down to
           it, or "anything chocolate?" returns a shrug next to a product page
           with the word chocolate written on it. */
        var haveNotes = SITE.products.some(function (p) { return listOf(p.flavor_notes).length; });
        if (flav.length && flav[0].score >= (haveNotes ? 2 : 1)) {
          return answerList('Going by flavour, these are the closest:', flav.slice(0, 3), function (r) {
            var p = r.p || r;
            var notes = listOf(p.flavor_notes).slice(0, 3).map(cap).join(' · ');
            return notes || (r.hits || []).join(' · ');
          });
        }
        var all = SITE.products.filter(function (p) { return listOf(p.flavor_notes).length || p.description; });
        if (all.length) {
          return answerList('Here’s the flavour lineup — the ' + a(L.flavors, 'flavors page') + ' has all of it:', all.slice(0, 5), function (r) {
            var p = r.p || r;
            return listOf(p.flavor_notes).slice(0, 3).map(cap).join(' · ');
          });
        }
      }

      if (ASK.stock.test(q)) {
        var live = SITE.products.filter(function (p) { return p.available !== false; });
        var gone = SITE.products.filter(function (p) { return p.available === false; });
        if (SITE.products.length) {
          var html = '<p>' + live.length + ' of ' + SITE.products.length + ' products are in stock right now.</p>';
          if (gone.length) html += '<p>Currently sold out: ' + gone.map(function (p) { return escapeHtml(p.title); }).join(', ') + '.</p>';
          return { html: html + productCards(live.slice(0, 3)), chips: ['What would you recommend?'] };
        }
      }

      if (ASK.price.test(q) && (category || ASK.recommend.test(q))) {
        var priced = byPrice(false, category);
        if (priced.length) {
          return answerList('Current pricing — the product page is always the final word:', priced.slice(0, 5));
        }
      }

      if (ASK.recommend.test(q)) return answerRecommend(category);

      /* "What is hash rosin?" names a category but wants an explanation, not
         a product list. Hand those to the curated answers and the guides. */
      if (category && !DEFINITIONAL.test(q) && !SPEC.test(q)) return answerCatalogue(category);

      return null;
    }

    /* ══════════════════════════════════════════════════════════════════
       10. CONVERSATION FLOW
    ══════════════════════════════════════════════════════════════════ */
    var GREETING = /^\s*(hi|hey|hello|yo|howdy|sup|good (morning|afternoon|evening))\b/i;
    var THANKS   = /\b(thanks|thank you|thx|ty|appreciate it|cheers)\b/i;
    var HUMAN    = /\b(leave a message|human|real person|speak to someone|talk to someone|agent|representative|call me|email me|contact me)\b/i;

    var lastUnanswered = '';

    function deliver(result) {
      addMessage(result.html, 'bot');
      if (result.lead) renderLeadForm(lastUnanswered || '');
      else setChips(result.chips && result.chips.length ? result.chips : DEFAULT_CHIPS_FN());
      scrollDown();
    }

    function respond(question) {
      loadSite();
      var typing = addTyping();

      function finish(build, delay) {
        setTimeout(function () {
          typing.remove();
          build();
        }, delay || 460);
      }

      /* Compliance first — nothing gets to answer around it. */
      var stop = complianceCheck(question);
      if (stop) {
        lastUnanswered = '';
        return finish(function () { deliver(stop); });
      }

      if (HUMAN.test(question)) {
        return finish(function () {
          addMessage('<p>I’m SCOOP, the automated Sundaze assistant — but there’s a real team behind me, and they answer within about 24 hours. Drop your details below and I’ll pass everything along.</p>', 'bot');
          renderLeadForm(lastUnanswered || question);
        });
      }

      if (GREETING.test(question) && question.trim().split(/\s+/).length <= 4) {
        return finish(function () {
          addMessage('<p>Hey! I’m SCOOP 🍨 Ask me about the lineup, shipping, lab results — or just tell me the kind of session you’re after and I’ll find something.</p>', 'bot');
          setChips(DEFAULT_CHIPS_FN());
        });
      }

      if (THANKS.test(question) && question.trim().split(/\s+/).length <= 5) {
        return finish(function () {
          addMessage('<p>Anytime. That’s the scoop — shout if anything else comes up.</p>', 'bot');
          setChips(DEFAULT_CHIPS_FN());
        });
      }

      askAi(question).then(function (aiAnswer) {
        if (aiAnswer) {
          return finish(function () {
            addMessage('<p>' + escapeHtml(aiAnswer).replace(/\n+/g, '</p><p>') + '</p>', 'bot');
            setChips(DEFAULT_CHIPS_FN());
          }, 200);
        }

        /* Catalogue questions — answered live from the site index. */
        var routed = route(question);
        if (routed) {
          lastUnanswered = routed.lead ? question : '';
          return finish(function () { deliver(routed); });
        }

        /* Everything else — curated answers, pages and guides. */
        var results = search(question);
        var best = results[0];

        if (best && best.score >= CONFIDENT) {
          lastUnanswered = '';
          var row = best.row;

          if (row.kind === 'faq') {
            var related = results.slice(1, 3)
              .filter(function (r) { return r.score >= CONFIDENT * 0.55 && r.row.kind === 'faq'; })
              .map(function (r) { return r.row.title; });
            return finish(function () {
              addMessage(row.ref.a, 'bot');
              setChips(related.length ? related : DEFAULT_CHIPS_FN());
            });
          }

          if (row.kind === 'product') return finish(function () { deliver(answerProduct(row.ref)); });

          /* A page or a guide — quote what it says and link to the whole thing. */
          /* First few sentences of the page. Matching whole sentences avoids a
             lookbehind, which older Safari does not support. */
          var body = String(row.ref.content || '');
          var excerpt = (body.match(/[^.!?]+[.!?]+/g) || [body]).slice(0, 3).join(' ').trim();
          return finish(function () {
            addMessage(
              '<p>' + escapeHtml(excerpt) + '</p>' +
              '<p>Full detail here: ' + a(row.url, escapeHtml(row.title)) + '.</p>',
              'bot'
            );
            setChips(DEFAULT_CHIPS_FN());
          });
        }

        /* Not confident — don't invent an answer, capture the question. */
        lastUnanswered = question;
        finish(function () {
          var near = results.slice(0, 2)
            .filter(function (r) { return r.score > 0.5 && r.row.kind === 'faq'; })
            .map(function (r) { return r.row.title; });

          var html = '<p>That one’s outside what I’ve got on hand — and I’d rather not guess.</p>';
          html += near.length
            ? '<p>I can answer these if either is close, otherwise leave your details below and the team will get you a proper answer.</p>'
            : '<p>Leave your email or phone with the question and the Sundaze team will get back to you.</p>';
          addMessage(html, 'bot');
          renderLeadForm(question);
          if (near.length) setChips(near);
        }, 620);
      });
    }

    /* ══════════════════════════════════════════════════════════════════
       11. OPTIONAL LLM HOP
       Dormant unless `ai_endpoint` is set at the top of this snippet. When
       it is, SCOOP sends the question, the recent transcript AND the site
       content it just retrieved, so the model answers from this store rather
       than from whatever it happens to remember about hemp. Anything
       unexpected resolves to null and the engine above takes over.

       Never put an API key in here — this file is public. The endpoint has
       to be something you control that holds the key server-side.
    ══════════════════════════════════════════════════════════════════ */
    function askAi(question) {
      if (!AI_ENDPOINT) return Promise.resolve(null);

      var history = [].slice.call(log.querySelectorAll('.scoop__msg')).slice(-6).map(function (el) {
        return {
          role: el.classList.contains('scoop__msg--user') ? 'user' : 'assistant',
          content: el.textContent.trim()
        };
      });

      /* Ground the model in the same site content the local engine found. */
      var context = search(question).slice(0, 5).map(function (r) {
        return { kind: r.row.kind, title: r.row.title, url: r.row.url, text: r.row.ref && (r.row.ref.a || r.row.ref.content || r.row.ref.description) || '' };
      });

      return fetch(AI_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: question, history: history, context: context })
      })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { return (d && typeof d.answer === 'string' && d.answer.trim()) ? d.answer.trim() : null; })
        .catch(function () { return null; });
    }

    function submit(text) {
      var question = String(text || input.value).trim();
      if (!question) return;
      input.value = '';
      input.style.height = 'auto';
      addMessage('<p>' + escapeHtml(question) + '</p>', 'user');
      setChips([]);
      respond(question);
    }

    /* ══════════════════════════════════════════════════════════════════
       12. HANDOFF TO A HUMAN
       Posts through Shopify's own contact form, so a question SCOOP could
       not answer lands in the store's notification inbox beside every other
       enquiry. An unanswered question is a lead, which is the whole point of
       refusing to guess.
    ══════════════════════════════════════════════════════════════════ */
    function renderLeadForm(prefill) {
      var card = document.createElement('div');
      card.className = 'scoop__msg scoop__msg--bot scoop__lead';
      card.innerHTML =
        '<h4>Let a human take it from here</h4>' +
        '<p class="scoop__lead-sub">Leave an email <em>or</em> a phone number and the Sundaze team will come back to you — usually within 24 hours.</p>' +
        '<label for="scoopLeadName">Name (optional)</label>' +
        '<input type="text" id="scoopLeadName" autocomplete="name" placeholder="Jordan">' +
        '<label for="scoopLeadEmail">Email</label>' +
        '<input type="email" id="scoopLeadEmail" autocomplete="email" placeholder="you@example.com">' +
        '<label for="scoopLeadPhone">Phone</label>' +
        '<input type="tel" id="scoopLeadPhone" autocomplete="tel" placeholder="(555) 123-4567">' +
        '<label for="scoopLeadMsg">Your question</label>' +
        '<textarea id="scoopLeadMsg" rows="3" placeholder="What can we help with?"></textarea>' +
        '<p class="scoop__lead-err" id="scoopLeadErr"></p>' +
        '<button type="button" class="scoop__lead-btn" id="scoopLeadSend">Send it over</button>';
      log.appendChild(card);

      var msgField = card.querySelector('#scoopLeadMsg');
      if (prefill) msgField.value = prefill;

      card.querySelector('#scoopLeadSend').addEventListener('click', function () {
        submitLead(card, this);
      });

      scrollDown();
      setChips([]);
    }

    function submitLead(card, button) {
      var name  = card.querySelector('#scoopLeadName').value.trim();
      var email = card.querySelector('#scoopLeadEmail').value.trim();
      var phone = card.querySelector('#scoopLeadPhone').value.trim();
      var body  = card.querySelector('#scoopLeadMsg').value.trim();
      var err   = card.querySelector('#scoopLeadErr');

      function fail(text) {
        err.textContent = text;
        err.classList.add('is-shown');
      }

      if (!email && !phone) return fail('Please leave either an email or a phone number so we can reply.');
      if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return fail('That email doesn’t look quite right.');
      if (!body) return fail('Add your question so the team knows what to answer.');

      err.classList.remove('is-shown');
      button.disabled = true;
      button.textContent = 'Sending…';

      /* Shopify's contact form needs a syntactically valid email address. If a
         shopper only left a phone number we still post — the number and the
         question are both in the body, so the team has what it needs to call
         back. Reply-to just won't be useful in that case. */
      var replyTo = email || ('no-reply@' + window.location.hostname);

      var lines = [
        'New question from SCOOP (site chat)',
        '',
        'Name:  ' + (name || 'Not given'),
        'Email: ' + (email || 'Not given'),
        'Phone: ' + (phone || 'Not given'),
        'Page:  ' + window.location.href,
        '',
        'Question:',
        body
      ];

      var data = new FormData();
      data.append('form_type', 'contact');
      data.append('utf8', '✓');
      data.append('contact[email]', replyTo);
      if (name) data.append('contact[name]', name);
      if (phone) data.append('contact[phone]', phone);
      data.append('contact[body]', lines.join('\n'));

      fetch('/contact', { method: 'POST', body: data, headers: { 'Accept': 'text/html' } })
        .then(function (res) {
          if (!res.ok) throw new Error('contact form rejected the submission');
          card.remove();
          addMessage(
            '<p>Got it — that’s on its way to the team. 🍨</p>' +
            '<p>They usually reply within 24 hours. Anything else I can dig up in the meantime?</p>',
            'bot'
          );
          setChips(DEFAULT_CHIPS_FN());
        })
        .catch(function () {
          button.disabled = false;
          button.textContent = 'Send it over';
          fail('That didn’t go through. You can also reach us on the contact page.');
        });
    }

    /* ══════════════════════════════════════════════════════════════════
       13. OPEN / CLOSE
    ══════════════════════════════════════════════════════════════════ */
    var started = false;

    function greet() {
      if (started) return;
      started = true;
      loadSite();

      var count = SITE.products.length;
      addMessage(
        '<p>Hi, I’m <strong>SCOOP</strong> 🍨 — here to give you the inside scoop on Sundaze.</p>' +
        '<p>I know ' + (count ? 'all ' + count + ' products' : 'the lineup') + ', the guides and the policies on this site. Ask me anything — or tell me the kind of session you’re after and I’ll find something. If I don’t know, I’ll get you to someone who does.</p>',
        'bot'
      );
      setChips(DEFAULT_CHIPS_FN());
    }

    function openPanel() {
      widget.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
      launcher.setAttribute('aria-expanded', 'true');
      badge.hidden = true;
      try { sessionStorage.setItem('scoop_seen', '1'); } catch (e) {}
      greet();
      setTimeout(function () { input.focus(); }, 220);
    }

    function closePanel() {
      widget.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      launcher.setAttribute('aria-expanded', 'false');
      launcher.focus();
    }

    launcher.addEventListener('click', function () {
      widget.classList.contains('is-open') ? closePanel() : openPanel();
    });
    closeBtn.addEventListener('click', closePanel);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && widget.classList.contains('is-open')) closePanel();
    });

    sendBtn.addEventListener('click', function () { submit(); });

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        submit();
      }
    });

    input.addEventListener('input', function () {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 96) + 'px';
    });

    try {
      if (sessionStorage.getItem('scoop_seen')) badge.hidden = true;
    } catch (e) {}
  })();
</script>
