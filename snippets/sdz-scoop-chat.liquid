    /* ══════════════════════════════════════════════════════════════════
       1. THE SITE INDEX
       Parsed once, on first open, out of the JSON that sdz-scoop-catalog
       renders. Everything downstream reads from here — which is why SCOOP
       tracks the live store rather than a stale copy of it.
    ══════════════════════════════════════════════════════════════════ */
    var SITE = { products: [], collections: [], pages: [], articles: [], shop: {} };
    var siteLoaded = false;

    function loadSite() {
      if (siteLoaded) return;
      siteLoaded = true;
      try {
        var el = document.getElementById('scoopCatalog');
        if (!el) return;
        var data = JSON.parse(el.textContent);
        SITE.shop        = data.shop || {};
        SITE.products    = (data.products || []).filter(function (p) { return p && p.title; });
        SITE.collections = data.collections || [];
        SITE.pages       = data.pages || [];
        SITE.articles    = data.articles || [];
      } catch (e) {
        /* A malformed blob must never take the widget down — SCOOP falls
           back to the curated answers and the handoff form. */
        SITE.products = [];
      }
      SITE.products.forEach(enrichFromCopy);
      buildCorpus();
    }

    /* Metafield lists arrive as arrays, single-text as strings, unset as
       null. Normalise all three into a lowercased array. */
    function listOf(value) {
      if (!value) return [];
      var arr = Object.prototype.toString.call(value) === '[object Array]' ? value : String(value).split(',');
      var out = [];
      for (var i = 0; i < arr.length; i++) {
        var v = String(arr[i] || '').trim().toLowerCase();
        if (v) out.push(v);
      }
      return out;
    }

    function textOf(value) { return value == null ? '' : String(value).trim(); }

    /* ── PUBLISHED COPY AS A FALLBACK SOURCE ────────────────────────────
       The sundaze.* metafields are the preferred source and always win. But
       until they are filled in, every effect question dead-ends on "I can't
       match products to how they feel yet" — which is true about SCOOP and
       useless to the shopper, because the product pages have been publishing
       those words the whole time.

       So when a product carries no effect metafield, SCOOP falls back to the
       effect words its own product page already prints. Matched literally,
       against the fixed vocabulary below, with no synonym expansion and no
       inference: if the word is not on the page, it is not in the list.

       Repeating a word this store published and guessing how something feels
       are different acts, and only the second is a claim SCOOP would be
       making up. That one still cannot happen. Fill the metafields in and
       this layer goes quiet on its own — admin always wins.

       The THCa figure works the same way: the flower pages print it, so
       SCOOP ranks on what it read rather than pretending it has no numbers.
       Read, never calculated, never rounded. */
    var COPY_EFFECTS = [
      ['energized', /\benergi[sz](?:ing|ed)\b|\benergetic\b/i],
      ['uplifted',  /\buplift(?:ing|ed|s)?\b/i],
      ['motivated', /\bmotivat(?:ing|ed)\b/i],
      ['focused',   /\bfocus(?:ed|sed)\b/i],
      ['creative',  /\bcreativ(?:e|ity)\b/i],
      ['happy',     /\bhapp(?:y|iness)\b/i],
      ['euphoric',  /\beuphori(?:c|a)\b/i],
      ['blissful',  /\bbliss(?:ful)?\b/i],
      ['giggly',    /\bgiggl\w*\b/i],
      ['social',    /\bsocial\b/i],
      ['talkative', /\btalkative\b/i],
      ['relaxed',   /\brelax(?:ed|ing|ation)\b/i],
      ['calm',      /\bcalm(?:ing)?\b/i],
      ['peaceful',  /\bpeaceful\b/i],
      ['sleepy',    /\bsleepy\b/i],
      ['sedating',  /\bsedat(?:ing|ive)\b/i],
      ['restful',   /\brestful\b/i],
      ['balanced',  /\bbalanced\b/i]
    ];

    var COPY_THCA = /(\d{1,2}(?:\.\d+)?)\s*%\s*THC\s*-?\s*A\b/i;

    function enrichFromCopy(p) {
      var copy = String(p.description || '');
      p._copyEffects = [];
      p._copyThca    = null;
      if (!copy) return;

      if (!listOf(p.effects).length) {
        for (var i = 0; i < COPY_EFFECTS.length; i++) {
          if (COPY_EFFECTS[i][1].test(copy)) p._copyEffects.push(COPY_EFFECTS[i][0]);
        }
      }
      if (p.thca_percent == null) {
        var m = copy.match(COPY_THCA);
        if (m) p._copyThca = m[1];
      }
    }

    /* Admin metafield first, published copy second, nothing third. */
    function effectsOf(p) {
      var eff = listOf(p.effects);
      return eff.length ? eff : (p._copyEffects || []);
    }
    function thcaOf(p) {
      if (p.thca_percent != null) return p.thca_percent;
      return p._copyThca != null ? p._copyThca : null;
    }

    /* A product counts as "tagged" once effect wording exists for it, from
       either source. Products with neither stay invisible to effect matching
       by design — see section 2. */
    function isTagged(p) {
      return effectsOf(p).length > 0 || textOf(p.strain_type) !== '' || textOf(p.time_of_day) !== '';
    }
    function taggedProducts() { return SITE.products.filter(isTagged); }

    /* ══════════════════════════════════════════════════════════════════
       2. COMPLIANCE GATE — runs before anything else may answer.

       Sundaze sells hemp, where effect and health claims are regulated.
       These are hard stops, not preferences. SCOOP will not:
         · say a product treats, cures, eases or helps any condition
         · give a dose, an amount, or a "start with about this much"
         · advise anyone on medication, pregnancy or nursing
         · continue with anyone who says they are under 21
         · help route an order into a state Sundaze cannot ship to
         · describe an effect that isn't published on this store already

       Each stop hands off to a human instead. Deflecting a genuine customer
       costs one reply; a claim costs considerably more than that.
    ══════════════════════════════════════════════════════════════════ */
    var GUARD = {
      conditions: /\b(chronic pain|back pain|joint pain|nerve pain|pain relief|for pain|my pain|anxiety|anxious|panic attacks?|depress\w*|ptsd|insomnia|nausea|vomiting|appetite loss|cancer|chemo\w*|seizures?|epilep\w*|migraines?|arthritis|adhd|autism|glaucoma|crohn\w*|inflammation|withdrawals?|addiction|eating disorder|blood pressure|heart condition|diabet\w*|asthma|copd)\b/i,
      claim: /\b(cures?(?!\s+(?:yourself|myself))|heals?|healing|remedy|therapeutic|medicinal|medical (?:use|grade|benefit|advice)|symptoms?|diseases?|illness)\b/i,
      dosage: /\b(how much should i|how much do i|how many should i|how many do i|dosage|dosing|correct dose|right dose|proper dose|milligrams?|overdose|too much|safe amount|how much is safe)\b/i,
      interaction: /\b(medication|medications|prescription|antidepressants?|ssri|blood thinner|pregnan\w*|nursing|breastfeed\w*|drug interaction)\b/i,
      minor: /\b(?:i'?m|i am|im)\s?(?:1[0-9]|20)\b|\b(?:under ?21|not 21|underage|a minor|my kid|my son|my daughter|for a teen)\b/i,
      evasion: /\b(fake id|beat (?:a|the) drug test|pass (?:a|the) drug test|get around|work around|bypass|sneak|smuggle|reroute|forwarding address)\b/i
    };

    var RESTRICTED = /\b(arkansas|idaho|minnesota|oregon|rhode island|texas|vermont)\b/i;

    /* Returns a hard-stop reply, or null to let the question carry on down
       the normal path. */
    function complianceCheck(q) {
      if (GUARD.minor.test(q)) {
        return {
          html: '<p>I have to stop there — Sundaze is strictly 21+, and I can’t help with a purchase for anyone under that age.</p>' +
                '<p>Nothing personal. It’s the one rule we don’t bend.</p>',
          chips: []
        };
      }

      if (GUARD.evasion.test(q) || (RESTRICTED.test(q) && /\b(around|anyway|somehow|still|any ?way)\b/i.test(q))) {
        return {
          html: '<p>That’s not something I can help with.</p>' +
                '<p>We don’t ship to Arkansas, Idaho, Minnesota, Oregon, Rhode Island, Texas or Vermont, and there’s no way around that on our end. Full detail on the ' + a(L.shipping, 'shipping policy page') + '.</p>',
          chips: ['Which states do you not ship to?']
        };
      }

      if (GUARD.dosage.test(q)) {
        return {
          html: '<p>I can’t advise on amounts — that’s genuinely individual, and it isn’t something an automated assistant should be guessing at.</p>' +
                '<p>What I can tell you is exactly what’s in each product and how it’s made. For how much is right for you, please talk to a healthcare professional.</p>',
          chips: ['What is in a hash hole?', 'Where are the lab results?']
        };
      }

      if (GUARD.interaction.test(q)) {
        return {
          html: '<p>That one needs a real clinician, not me. If you’re pregnant, nursing, or taking prescription medication, please check with your healthcare provider before using any hemp-derived product.</p>' +
                '<p>I’d rather point you to the right person than give you an answer I’m not qualified to give.</p>',
          chips: []
        };
      }

      if (GUARD.conditions.test(q) || GUARD.claim.test(q)) {
        return {
          html: '<p>I can’t speak to health conditions or medical use — our products aren’t intended to diagnose, treat, cure or prevent any disease, and they haven’t been evaluated by the FDA.</p>' +
                '<p>Please take that one to a healthcare professional. I’m glad to cover anything about the products themselves: how they’re made, what’s in them, or what the lab results say.</p>',
          chips: ['Where are the lab results?', 'What is hash rosin?']
        };
      }

      return null;
    }

    /* Appended to every answer that touches effects. Non-negotiable. */
    var EFFECT_DISCLAIMER =
      '<p class="scoop__fine">Effects vary from person to person. Not evaluated by the FDA and not intended to diagnose, treat, cure or prevent any disease. 21+ only.</p>';

